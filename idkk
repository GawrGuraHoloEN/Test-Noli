local function AddAcc(tableinfo)
		local E = Instance.new('Folder',tableinfo.Parent or nil)
		E.Name = tableinfo.Name or 'Nil'
		E:SetAttribute('Owner',tableinfo.Owner.Name or 'NoOwner')
		if tableinfo.Name == 'Slowalk' then
			E:SetAttribute('Walk',tableinfo.Walk)
			E:SetAttribute('Jump',tableinfo.Jump)
			E:SetAttribute('Div',tableinfo.Walk)
		end
		if tableinfo.Name == 'Freeze' then
			E:SetAttribute(tableinfo.NoStop)
		end
		if tableinfo.Time ~= nil then
			task.delay(tableinfo.Time,function()
				if E.Parent == tableinfo.Parent then
					E:Destroy()
				end
			end)
		end
	return E
end

