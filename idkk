local function Emit(Part: Part?)
		if Part:IsA('ParticleEmitter') then
			Part:Emit(Part:GetAttribute('EmitCount'))
		else
			for _,v in Part:GetDescendants() do
				if v:IsA('ParticleEmitter') then
					v:Emit(v:GetAttribute('EmitCount'))
				end
			end
	end
end

local function Flashing(Character: Model, Time: number)
	for _, Part: Part? in Character:GetDescendants() do
		if Part:GetAttribute("NoTransparancyChange") ~= true and Part:IsA("Part") and typeof(Part.Transparency) ~= 'NumberSequence' and Part.Transparency == 0 then
			Part:AddTag('BecomeVisible')

			Part.Transparency = 1
		end
	end

	task.wait(Time)

	for _, Part: Part? in Character:GetDescendants() do
		if Part:HasTag('BecomeVisible') then
			Part:RemoveTag('BecomeVisible')

			Part.Transparency = 0
		end
	end
end

