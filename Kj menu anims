----------------------------------------------------------------

local function playCustomSpawn(character, humanoid, animator)
	-- Cargar track original
	local anim = Instance.new("Animation")
	anim.AnimationId = "rbxassetid://17325160621"
	local track = animator:LoadAnimation(anim)
	anim:Destroy()
	
	track.Priority = Enum.AnimationPriority.Action4
	track:Play(0.15)
	table.insert(currentTracks, track)
	
	-- Sonido original
	-- (sin Debris: solo se destruye al terminar de sonar o si la anim se interrumpe)
	local sound = Instance.new("Sound")
	sound.SoundId = "rbxassetid://17325174223"
	sound.Volume = 2
	sound.Parent = getSoundParent(character)
	sound.Ended:Connect(function() sound:Destroy() end)
	sound:Play()
	table.insert(currentSounds, sound)
	
	-- Sonido Extra NUEVO
	local extraSound = Instance.new("Sound")
	extraSound.SoundId = "rbxassetid://17325206534"
	extraSound.Volume = 2
	extraSound.Parent = getSoundParent(character)
	extraSound.Ended:Connect(function() extraSound:Destroy() end)
	extraSound:Play()
	table.insert(currentSounds, extraSound)

	-- Variables de estado
	local isSpawnActive = true
	local rightArm = character:FindFirstChild("Right Arm") or character:FindFirstChild("RightHand")
	local phoneModelTemplate = ReplicatedStorage:FindFirstChild("Resources") and ReplicatedStorage.Resources:FindFirstChild("PhonePhysicsTest")
	local clonedPhone = nil
	local phoneWeld = nil
	
	-- ==========================================
	-- ACCIÓN 1: Quitar herramientas y cambiar UI 
	-- ==========================================
	task.delay(0.03, function()
		if not isSpawnActive then return end
		
		local backpack = player:FindFirstChild("Backpack")
		if backpack then
			backpack:ClearAllChildren()
		end
		
		for _, child in ipairs(character:GetChildren()) do
			if child:IsA("Tool") then
				child:Destroy()
			end
		end
		
		local uiBar = playerGui:FindFirstChild("Bar", true)
		if uiBar and uiBar.Parent == playerGui then
			local magicHealth = uiBar:FindFirstChild("MagicHealth")
			if magicHealth then
				local textLabel = magicHealth:FindFirstChild("TextLabel")
				if textLabel then
					textLabel.Text = "20 SERIES"
				end
			end
		end
	end)
	
	-- ==========================================
	-- ACCIÓN 2: Configurar, ajustar posición y soldar modelo Phone
	-- ==========================================
	if phoneModelTemplate and rightArm then
		clonedPhone = phoneModelTemplate:Clone()
		clonedPhone.Parent = workspace
		Debris:AddItem(clonedPhone, 6)
		
		local mainPart = clonedPhone.PrimaryPart
		if not mainPart then
			mainPart = clonedPhone:FindFirstChildWhichIsA("BasePart", true)
		end
		
		if mainPart then
			-- Offset del teléfono respecto al brazo derecho (Y = -1.5 studs)
			clonedPhone:PivotTo(rightArm.CFrame * CFrame.new(0, -1.5, 0) * CFrame.Angles(math.rad(-90), 0, 0))
			
			for _, part in ipairs(clonedPhone:GetDescendants()) do
				if part:IsA("BasePart") then
					part.Anchored = false
					part.CanCollide = false
					part.Massless = true
					
					if part ~= mainPart then
						local internalWeld = Instance.new("WeldConstraint")
						internalWeld.Part0 = mainPart
						internalWeld.Part1 = part
						internalWeld.Parent = mainPart
					end
				end
			end
			
			phoneWeld = Instance.new("WeldConstraint")
			phoneWeld.Part0 = rightArm
			phoneWeld.Part1 = mainPart
			phoneWeld.Parent = mainPart
			
			for _, vfx in ipairs(clonedPhone:GetDescendants()) do
				if vfx:IsA("ParticleEmitter") then
					vfx.Enabled = true
					vfx:Emit(3)
					vfx.Enabled = false
				end
			end
		else
			clonedPhone:Destroy()
			clonedPhone = nil
		end
	end
	
	-- ==========================================
	-- ACCIÓN 3: Soltar y separar en 1.2 segundos
	-- ==========================================
	task.delay(1.2, function()
		if not isSpawnActive then return end
		
		if phoneWeld and phoneWeld.Parent then
			phoneWeld:Destroy()
		end
		
		if clonedPhone and clonedPhone.Parent then
			-- Obtener los dos primeros modelos internos (o buscar hijos directos que sean Modelos/Partes)
			local subModelos = {}
			for _, child in ipairs(clonedPhone:GetChildren()) do
				if child:IsA("Model") or child:IsA("BasePart") then
					table.insert(subModelos, child)
				end
			end
			
			-- Si tiene submodelos internos, los separamos al caer, sino aplicamos a todas las piezas
			if #subModelos >= 2 then
				-- Agrupar las piezas de cada submodelo
				local grupos = {}
				local grupoDePieza = {}
				for indice, subModel in ipairs(subModelos) do
					local piezas = {}
					if subModel:IsA("BasePart") then
						table.insert(piezas, subModel)
					end
					for _, descendant in ipairs(subModel:GetDescendants()) do
						if descendant:IsA("BasePart") then
							table.insert(piezas, descendant)
						end
					end
					grupos[indice] = piezas
					for _, pieza in ipairs(piezas) do
						grupoDePieza[pieza] = indice
					end
				end

				-- Romper SOLO las uniones entre submodelos distintos (las de dentro de cada uno se conservan)
				for _, descendant in ipairs(clonedPhone:GetDescendants()) do
					if descendant:IsA("WeldConstraint") or descendant:IsA("JointInstance") then
						if grupoDePieza[descendant.Part0] ~= grupoDePieza[descendant.Part1] then
							descendant:Destroy()
						end
					end
				end

				-- Mantener unidas las piezas de cada submodelo y soltarlos en direcciones opuestas
				local direccion = 1
				for _, piezas in ipairs(grupos) do
					local principal = piezas[1]
					if principal then
						for _, pieza in ipairs(piezas) do
							pieza.Anchored = false
							pieza.CanCollide = true
							if pieza ~= principal then
								local weld = Instance.new("WeldConstraint")
								weld.Part0 = principal
								weld.Part1 = pieza
								weld.Parent = principal
							end
						end
						principal.AssemblyLinearVelocity = Vector3.new(15 * direccion, 10, 0)
					end
					direccion = -1 -- Invertir dirección para el segundo modelo
				end
			else
				-- Comportamiento general por si es un modelo plano de piezas
				local dir = 1
				for _, part in ipairs(clonedPhone:GetDescendants()) do
					if part:IsA("BasePart") then
						part.Anchored = false
						part.CanCollide = true
						part.AssemblyLinearVelocity = Vector3.new(12 * dir, 10, 0)
						dir = -dir
					end
				end
			end
		end
	end)
	
	-- ==========================================
	-- ACCIÓN 4: Monitor y Limpieza por interrupción
	-- ==========================================
	local spawnStart = os.clock()
	local spawnConn = nil
	spawnConn = RunService.RenderStepped:Connect(function()
		if not character.Parent or not humanoid.Parent or not track.IsPlaying then
			isSpawnActive = false

			local naturalEnd = character.Parent and humanoid.Parent
				and track.Length > 0
				and os.clock() - spawnStart >= track.Length - 0.2

			-- Solo cortar los sonidos si la animación fue interrumpida
			if not naturalEnd then
				if sound and sound.Parent then sound:Destroy() end
				if extraSound and extraSound.Parent then extraSound:Destroy() end
			end
			if clonedPhone and clonedPhone.Parent then clonedPhone:Destroy() end

			if spawnConn then
				spawnConn:Disconnect()
				spawnConn = nil
			end
			return
		end

		if humanoid.MoveDirection.Magnitude > 0 then
			isSpawnActive = false
			track:Stop(0.15)

			if sound and sound.Parent then sound:Destroy() end
			if extraSound and extraSound.Parent then extraSound:Destroy() end
			if clonedPhone and clonedPhone.Parent then clonedPhone:Destroy() end

			if spawnConn then
				spawnConn:Disconnect()
				spawnConn = nil
			end
			return
		end

		for _, otherTrack in ipairs(animator:GetPlayingAnimationTracks()) do
			if otherTrack ~= track then
				otherTrack:Stop(0)
				otherTrack:AdjustWeight(0)
			end
		end
	end)
end

local function listenForSpawnAnim(character)
	if not character or not character.Parent then return end
	
	local humanoid = character:WaitForChild("Humanoid", 5)
	if not humanoid or humanoid.Health <= 0 then return end
	
	local animator = humanoid:WaitForChild("Animator", 5)
	if not animator then return end

	local TARGET_ANIM_ID = "15957366251"
	local playedConnection = nil

	local function triggerOurAnimation(trackToCancel)
		hasCustomSpawnPlayed = true 
		
		-- Créditos: solo cuando la animación de spawn se activa
		showNotification("Character based on KJ's Final Ride & KJ Kills Day\nCredits to Kilojoule & Stealth")
		
		if playedConnection then
			playedConnection:Disconnect()
			playedConnection = nil
		end
		if trackToCancel then
			trackToCancel:Stop(0)
		end
		playCustomSpawn(character, humanoid, animator)
	end

	for _, track in ipairs(animator:GetPlayingAnimationTracks()) do
		if track.Animation and string.find(track.Animation.AnimationId, TARGET_ANIM_ID) then
			triggerOurAnimation(track)
			return
		end
	end

	playedConnection = animator.AnimationPlayed:Connect(function(track)
		if track.Animation and string.find(track.Animation.AnimationId, TARGET_ANIM_ID) then
			triggerOurAnimation(track)
		end
	end)
	
	task.delay(6, function()
		if playedConnection then
			playedConnection:Disconnect()
			playedConnection = nil
		end
	end)
end

