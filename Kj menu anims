addMove("20-20-20 Dropkick", function(token)
    playAnimation("17354976067")
    playSound("17356346310", 0, token)
    playSound("17429233290", 0, token)
end)

addMove("20 Series", function(token)
    local _, humanoid = getCharacter()
    if humanoid.MoveDirection.Magnitude > 0 then
        playAnimation("18445236460")
        playSound("18445228136", 0, token)
        playSound("18445228824", 0, token)
        playSound("18445227792", 0, token)
    else
        playAnimation("17140902079")
        playSound("17150550559", 0, token)
        playSound("17150550302", 0, token)
    end
end)

