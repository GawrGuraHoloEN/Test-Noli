local function startUltMusic(token)
	if token and token ~= sequence then return end
	if not ultMusicEnabled or ultSound then return end
	local character = player.Character
	if not character then return end

	local sound = Instance.new("Sound")
	sound.Name = "UltMusic"
	sound.SoundId = "rbxassetid://" .. ULT_MUSIC_ID
	sound.Volume = 2
	sound.Looped = true
	sound.Parent = getSoundParent(character)

