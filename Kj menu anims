local WALL_COMBO_FINAL_LIFETIME = 3         -- ...y aparece FinalImpact (dura 3 s, sin bucle)

local function getRightLeg(character)
	return character:FindFirstChild("Right Leg")
		or character:FindFirstChild("RightLowerLeg")
		or character:FindFirstChild("RightFoot")
end

local function getWallComboVfxTemplate(name)
	local kjEffects = getKJEffects()
	local folder = kjEffects and kjEffects:FindFirstChild("KJWallCombo")
	return folder and folder:FindFirstChild(name)
end

-- Copia un VFX sobre una pieza. Si es un Folder, se copia cada hijo igual que los demás.
local function placeVfxOnPart(template, targetPart, results, rotationOffset)
	rotationOffset = rotationOffset or CFrame.new()

	if template:IsA("Folder") then
		for _, child in ipairs(template:GetChildren()) do
			placeVfxOnPart(child, targetPart, results, rotationOffset)
		end
		return
	end

	local object = template:Clone()

	if object:IsA("Attachment") then
		object.Parent = targetPart
		object.CFrame = rotationOffset
	elseif object:IsA("BasePart") then
		object.Anchored = false
		object.CanCollide = false
		object.CanQuery = false
		object.CanTouch = false
		object.Massless = true
		object.CFrame = targetPart.CFrame * rotationOffset
		object.Parent = targetPart

		local weld = Instance.new("WeldConstraint")
		weld.Part0 = targetPart
		weld.Part1 = object
		weld.Parent = object
	elseif object:IsA("Model") then
		object.Parent = workspace
		object:PivotTo(targetPart.CFrame * rotationOffset)

		local main = object.PrimaryPart or object:FindFirstChildWhichIsA("BasePart", true)
		for _, part in ipairs(object:GetDescendants()) do
			if part:IsA("BasePart") then
				part.Anchored = false
				part.CanCollide = false
				part.CanQuery = false
				part.CanTouch = false
				part.Massless = true
				if part ~= main then
					local w = Instance.new("WeldConstraint")
					w.Part0 = main
					w.Part1 = part
					w.Parent = main
				end
			end
		end
		if main then
			local weld = Instance.new("WeldConstraint")
			weld.Part0 = targetPart
			weld.Part1 = main
			weld.Parent = main
		end
	else
		object.Parent = targetPart
	end

	table.insert(results, object)
end

-- Emite una sola vez (sin bucle). Usa el atributo "EmitCount" si existe.
local function emitBurst(instance, defaultCount)
	local emitters = instance:GetDescendants()
	table.insert(emitters, instance)

	for _, emitter in ipairs(emitters) do
		if emitter:IsA("ParticleEmitter") then
			emitter.Enabled = false
			emitter:Emit(emitter:GetAttribute("EmitCount") or defaultCount)
		end
	end
end

-- Coloca un VFX de KJWallCombo sobre una pieza, lo emite y lo elimina tras "lifetime" segundos
local function spawnWallComboVfx(name, targetPart, lifetime, defaultCount, token, rotationOffset)
	if token ~= sequence then return {} end
	if not targetPart or not targetPart.Parent then return {} end

	local template = getWallComboVfxTemplate(name)
	if not template then return {} end

	local results = {}
	placeVfxOnPart(template, targetPart, results, rotationOffset)

	for _, object in ipairs(results) do
		table.insert(currentVfx, object)
		Debris:AddItem(object, lifetime)
		emitBurst(object, defaultCount)
	end

	return results
end

