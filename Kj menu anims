-- LocalScript: place in StarterPlayer > StarterPlayerScripts
-- Draggable animation menu with scrolling list
-- Ult Music toggle: loops until turned off
-- Wall Combo: waits 2.9s, then shows numbered decals/images in order
-- each image stays visible for 0.014s and changes with a 0.014s cooldown

local Players = game:GetService("Players")
local UserInputService = game:GetService("UserInputService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local ContentProvider = game:GetService("ContentProvider")

local player = Players.LocalPlayer
local playerGui = player:WaitForChild("PlayerGui")

local currentTracks = {}
local currentSounds = {}
local sequence = 0

local ULT_MUSIC_ID = "17150550093"
local WALL_COMBO_ANIMATION_ID = "18447913645"

local WALL_DECAL_DELAY = 2.9
local WALL_DECAL_DISPLAY_TIME = 0.014
local WALL_DECAL_COOLDOWN = 0.014

local ultMusicEnabled = false
local ultSound = nil

local gui = Instance.new("ScreenGui")
gui.Name = "AnimationSoundMenu"
gui.ResetOnSpawn = false
gui.IgnoreGuiInset = true
gui.Parent = playerGui

local function getCharacter()
	local character = player.Character or player.CharacterAdded:Wait()

	local humanoid = character:FindFirstChildOfClass("Humanoid")
		or character:WaitForChild("Humanoid")

	local animator = humanoid:FindFirstChildOfClass("Animator")

	if not animator then
		animator = Instance.new("Animator")
		animator.Parent = humanoid
	end

	return character, humanoid, animator
end

local function getTorso(character)
	return character:FindFirstChild("Torso")
		or character:FindFirstChild("UpperTorso")
		or character:FindFirstChild("HumanoidRootPart")
		or character
end

local function stopCurrent()
	sequence += 1

	for _, track in ipairs(currentTracks) do
		if track and track.IsPlaying then
			track:Stop(0.15)
		end
	end
	table.clear(currentTracks)

	for _, sound in ipairs(currentSounds) do
		if sound then
			sound:Stop()
			sound:Destroy()
		end
	end
	table.clear(currentSounds)
end

local function stopUltMusic()
	if ultSound then
		ultSound:Stop()
		ultSound:Destroy()
		ultSound = nil
	end
end

local function startUltMusic()
	if not ultMusicEnabled or ultSound then
		return
	end

	local character = player.Character
	if not character then
		return
	end

	local sound = Instance.new("Sound")
	sound.Name = "UltMusic"
	sound.SoundId = "rbxassetid://" .. ULT_MUSIC_ID
	sound.Volume = 1
	sound.Looped = true
	sound.Parent = getTorso(character)

	ultSound = sound
	sound:Play()
end

local function playAnimation(id, priority)
	local _, _, animator = getCharacter()

	local animation = Instance.new("Animation")
	animation.AnimationId = "rbxassetid://" .. tostring(id)

	local track = animator:LoadAnimation(animation)
	animation:Destroy()

	track.Priority = priority or Enum.AnimationPriority.Action
	track:Play(0.15)

	table.insert(currentTracks, track)
	return track
end

local function playSound(id, delayTime, token)
	task.delay(delayTime or 0, function()
		if token ~= sequence then
			return
		end

		local character = getCharacter()
		local torso = getTorso(character)

		local sound = Instance.new("Sound")
		sound.SoundId = "rbxassetid://" .. tostring(id)
		sound.Volume = 1
		sound.Parent = torso

		table.insert(currentSounds, sound)

		sound.Ended:Connect(function()
			if sound and sound.Parent then
				sound:Destroy()
			end
		end)

		sound:Play()
	end)
end

local function playSoundThenUltMusic(soundId, token)
	task.spawn(function()
		if token ~= sequence or not ultMusicEnabled or ultSound then
			return
		end

		local character = getCharacter()
		local torso = getTorso(character)

		local sound = Instance.new("Sound")
		sound.SoundId = "rbxassetid://" .. tostring(soundId)
		sound.Volume = 1
		sound.Parent = torso

		table.insert(currentSounds, sound)

		sound.Ended:Connect(function()
			if sound and sound.Parent then
				sound:Destroy()
			end

			if ultMusicEnabled then
				startUltMusic()
			end
		end)

		sound:Play()
	end)
end

local function getNumberFromName(name)
	return tonumber(string.match(name, "%d+")) or math.huge
end

local function getAssetId(texture)
	if not texture or texture == "" then
		return nil
	end

	return string.match(texture, "%d+")
end

local function removeOldWallComboGui()
	local oldGui = playerGui:FindFirstChild("WallComboSequence")
	if oldGui then
		oldGui:Destroy()
		task.wait()
	end
end

local function showWallComboDecals(token)
	task.delay(WALL_DECAL_DELAY, function()
		if token ~= sequence then
			return
		end

		removeOldWallComboGui()

		local resources = ReplicatedStorage:FindFirstChild("Resources")
		local kjEffects = resources and resources:FindFirstChild("KJEffects")
		local wallsFolder = kjEffects and kjEffects:FindFirstChild("Walls")

		if not wallsFolder then
			warn("ReplicatedStorage.Resources.KJEffects.Walls was not found.")
			return
		end

		local wallGui = Instance.new("ScreenGui")
		wallGui.Name = "WallComboSequence"
		wallGui.IgnoreGuiInset = true
		wallGui.ResetOnSpawn = false
		wallGui.DisplayOrder = 100
		wallGui.Parent = playerGui

		local background = Instance.new("Frame")
		background.Name = "Background"
		background.Size = UDim2.fromScale(1, 1)
		background.Position = UDim2.fromScale(0, 0)
		background.BackgroundColor3 = Color3.new(0, 0, 0)
		background.BackgroundTransparency = 0
		background.BorderSizePixel = 0
		background.ZIndex = 1
		background.Parent = wallGui

		local frames = {}

		local framesFolder = wallsFolder:FindFirstChild("Frames", true)

		if framesFolder then
			for _, object in ipairs(framesFolder:GetChildren()) do
				if object:IsA("ImageLabel") or object:IsA("ImageButton") then
					table.insert(frames, {
						name = object.Name,
						number = getNumberFromName(object.Name),
						image = object.Image,
					})
				end
			end
		end

		if #frames == 0 then
			for _, object in ipairs(wallsFolder:GetDescendants()) do
				if object:IsA("Decal") then
					local assetId = getAssetId(object.Texture)
					if assetId then
						table.insert(frames, {
							name = object.Name,
							number = getNumberFromName(object.Name),
							image = "rbxassetid://" .. assetId,
						})
					end
				end
			end
		end

		table.sort(frames, function(firstFrame, secondFrame)
			if firstFrame.number == secondFrame.number then
				return firstFrame.name < secondFrame.name
			end

			return firstFrame.number < secondFrame.number
		end)

		if #frames == 0 then
			warn("No numbered frames or decals were found in ReplicatedStorage.Resources.KJEffects.Walls.")
			wallGui:Destroy()
			return
		end

		local imageObjects = {}

		for index, frameData in ipairs(frames) do
			local image = Instance.new("ImageLabel")
			image.Name = "WallFrame_" .. tostring(index)
			image.Size = UDim2.fromScale(1, 1)
			image.Position = UDim2.fromScale(0, 0)
			image.BackgroundTransparency = 1
			image.BorderSizePixel = 0
			image.Image = frameData.image
			image.ImageTransparency = 1
			image.ScaleType = Enum.ScaleType.Stretch
			image.ZIndex = 2
			image.Parent = wallGui

			table.insert(imageObjects, image)
		end

		if #imageObjects > 0 then
			local success, err = pcall(function()
				ContentProvider:PreloadAsync(imageObjects)
			end)

			if not success then
				warn("Wall Combo image preload failed:", err)
			end
		end

		for _, image in ipairs(imageObjects) do
			if token ~= sequence or not wallGui.Parent then
				wallGui:Destroy()
				return
			end

			for _, otherImage in ipairs(imageObjects) do
				otherImage.ImageTransparency = 1
			end

			image.ImageTransparency = 0
			task.wait(WALL_DECAL_DISPLAY_TIME)

			image.ImageTransparency = 1
			task.wait(WALL_DECAL_COOLDOWN)
		end

		if wallGui and wallGui.Parent then
			wallGui:Destroy()
		end
	end)
end

