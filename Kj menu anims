for order, name in ipairs(moveOrder) do
    local callback = moves[name]
    local button = Instance.new("TextButton")
    button.Size = UDim2.fromOffset(196, 34)
    button.BackgroundColor3 = Color3.fromRGB(48, 48, 62)
    button.TextColor3 = Color3.new(1, 1, 1)
    button.Text = name
    button.TextSize = 13
    button.Font = Enum.Font.Gotham
    button.LayoutOrder = order
    button.Parent = frame
    Instance.new("UICorner", button).CornerRadius = UDim.new(0, 6)

    button.Activated:Connect(function()
        stopCurrent()
        local token = sequence
        callback(token)
    end)
end

openButton.Activated:Connect(function()
    frame.Visible = not frame.Visible
end)

player.CharacterRemoving:Connect(function()
    if movementConnection then
        movementConnection:Disconnect()
        movementConnection = nil
    end
    stopCurrent()
end)

player.CharacterAdded:Connect(playSpawnAnimation)

if player.Character then
    task.defer(playSpawnAnimation, player.Character)
end
