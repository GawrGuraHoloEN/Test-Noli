local dragging, dragStart, menuStart = false, nil, nil
header.InputBegan:Connect(function(input)
	if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
		dragging, dragStart, menuStart = true, input.Position, menu.Position
		input.Changed:Connect(function() if input.UserInputState == Enum.UserInputState.End then dragging = false end end)
	end
end)
UserInputService.InputChanged:Connect(function(input)
	if dragging and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
		local delta = input.Position - dragStart
		menu.Position = UDim2.fromOffset(math.max(0, menuStart.X.Offset + delta.X), math.max(0, menuStart.Y.Offset + delta.Y))
	end
end)
player.CharacterRemoving:Connect(function() stopCurrent(); stopUltMusic() end)
