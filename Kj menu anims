-- LocalScript: place in StarterPlayer > StarterPlayerScripts
-- Animation menu with sounds, Wall Combo frames, and 20 Series VFX.

local Players = game:GetService("Players")
local UserInputService = game:GetService("UserInputService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local ContentProvider = game:GetService("ContentProvider")
local Debris = game:GetService("Debris")

local player = Players.LocalPlayer
local playerGui = player:WaitForChild("PlayerGui")
local currentTracks, currentSounds, currentVfx = {}, {}, {}
local sequence = 0
local ultMusicEnabled, ultSound = false, nil
local ULT_MUSIC_ID = "17150550093"
local WALL_COMBO_ANIMATION_ID = "18447913645"
local VFX_FOLDER_PATH = { "Resources", "KJEffects" }
-- The last asset was supplied as a placeholder in the request. Change this name
-- if the Attachment/Part has a different name in ReplicatedStorage.
local FINAL_VFX_NAME = "fine...Emit2"

local function getCharacter()
	local c = player.Character or player.CharacterAdded:Wait()
	local h = c:FindFirstChildOfClass("Humanoid") or c:WaitForChild("Humanoid")
	local a = h:FindFirstChildOfClass("Animator")
	if not a then a = Instance.new("Animator"); a.Parent = h end
	return c, h, a
end
local function getTorso(c)
	return c:FindFirstChild("Torso") or c:FindFirstChild("UpperTorso") or c:FindFirstChild("HumanoidRootPart") or c
end
local function getKJEffects()
	local object = ReplicatedStorage
	for _, name in ipairs(VFX_FOLDER_PATH) do
		object = object:FindFirstChild(name)
		if not object then return nil end
	end
	return object
end
local function destroyVfx(object)
	if object and object.Parent then object:Destroy() end
end
local function clearVfx()
	for object in ipairs(currentVfx) do destroyVfx(object) end
	table.clear(currentVfx)
end
local function stopCurrent()
	sequence += 1
	for _, track in ipairs(currentTracks) do if track and track.IsPlaying then track:Stop(0.15) end end
	table.clear(currentTracks)
	for _, sound in ipairs(currentSounds) do if sound then sound:Stop(); sound:Destroy() end end
	table.clear(currentSounds)
	clearVfx()
	local old = playerGui:FindFirstChild("WallComboSequence")
	if old then old:Destroy() end
end
local function stopUltMusic()
	if ultSound then ultSound:Stop(); ultSound:Destroy(); ultSound = nil end
end
local function startUltMusic()
	if not ultMusicEnabled or ultSound or not player.Character then return end
	local sound = Instance.new("Sound")
	sound.Name, sound.SoundId, sound.Volume, sound.Looped = "UltMusic", "rbxassetid://"..ULT_MUSIC_ID, 1, true
	sound.Parent = getTorso(player.Character); ultSound = sound; sound:Play()
end
local function playAnimation(id, priority)
	local _, _, animator = getCharacter()
	local animation = Instance.new("Animation"); animation.AnimationId = "rbxassetid://"..tostring(id)
	local track = animator:LoadAnimation(animation); animation:Destroy()
	track.Priority = priority or Enum.AnimationPriority.Action; track:Play(0.15)
	table.insert(currentTracks, track)
	return track
end
local function playSound(id, delayTime, token)
	task.delay(delayTime or 0, function()
		if token ~= sequence then return end
		local sound = Instance.new("Sound"); sound.SoundId = "rbxassetid://"..tostring(id); sound.Volume = 1; sound.Parent = getTorso(getCharacter())
		table.insert(currentSounds, sound)
		sound.Ended:Connect(function() if sound.Parent then sound:Destroy() end end)
		sound:Play()
	end)
end
local function playSoundThenUltMusic(id, token)
	task.spawn(function()
		if token ~= sequence or not ultMusicEnabled or ultSound then return end
		local sound = Instance.new("Sound"); sound.SoundId = "rbxassetid://"..tostring(id); sound.Volume = 1; sound.Parent = getTorso(getCharacter())
		table.insert(currentSounds, sound)
		sound.Ended:Connect(function() if sound.Parent then sound:Destroy() end; if ultMusicEnabled and token == sequence then startUltMusic() end end)
		sound:Play()
	end)
end

-- Clones one VFX, emits its particles immediately, and stops it safely with the move.
local function emitVfx(name, lifetime, token)
	if token ~= sequence then return nil end
	local folder = getKJEffects()
	local template = folder and folder:FindFirstChild(name)
	if not template then warn("VFX not found: ReplicatedStorage.Resources.KJEffects."..name); return nil end
	local character = player.Character or player.CharacterAdded:Wait()
	local targetPart = character:FindFirstChild("HumanoidRootPart") or character:WaitForChild("HumanoidRootPart")
	local object = template:Clone()
	if object:IsA("Attachment") then
		object.Parent = targetPart; object.Position = Vector3.zero
	elseif object:IsA("BasePart") then
		object.CFrame = targetPart.CFrame; object.Parent = workspace
	else
		object.Parent = targetPart
	end
	table.insert(currentVfx, object)
	Debris:AddItem(object, lifetime)
	for _, emitter in ipairs(object:GetDescendants()) do
		if emitter:IsA("ParticleEmitter") then emitter.Enabled = true; emitter:Emit(3); emitter.Enabled = false end
	end
	return object
end
local function play20SeriesVfx(track, token)
	-- fine...Emit is played once as soon as the animation starts.
	emitVfx("fine...Emit", 3, token)
	local started = os.clock()
	while token == sequence and track.IsPlaying and os.clock() - started < 8 do
		emitVfx("fine...Emit1", 0.5, token)
		emitVfx("fine...Emit1OG", 0.5, token)
		task.wait(0.2)
	end
	if token ~= sequence or not track.IsPlaying then return end
	-- These two are emitted only after the first eight seconds.
	emitVfx("fine...Emit2OG", 5, token)
	emitVfx(FINAL_VFX_NAME, 5, token)
end

