-- Impacto del clon: vuelo ragdoll, cráter y partes (Wall Combo)
----------------------------------------------------------------

local CLONE_FLY_SPEED = 150            -- velocidad hacia la izquierda del jugador
local CLONE_LAUNCH_DELAY = 0.1          -- espera antes de mandar volando al clon
local CLONE_FLY_UP = 45                -- impulso hacia arriba
local CLONE_TOUCH_GRACE = 0.12         -- tiempo en el que se ignoran toques (el clon empieza pegado al suelo)
local CLONE_MAX_TIME = 12              -- tiempo máximo de toda la secuencia ragdoll
local CLONE_SETTLE_SPEED = 3           -- por debajo de esta velocidad se considera que se detuvo
local CLONE_SETTLE_TIME = 0.9          -- durante cuánto tiempo debe estar detenido
local CLONE_GETUP_WAIT = 2             -- segundos que espera de pie antes de eliminarlo
local IMPACT_KEEP_TIME = 4             -- segundos extra que se mantienen el cráter y las partes
local IMPACT_SOUND_ID = "4307204452"
local CRATER_PART_COUNT = 8
local CRATER_PART_SIZE = 3.5             -- 3.5x3.5x3.5 studs
local CRATER_CLONE_DISTANCE = 2        -- distancia mínima entre el clon y cada parte
local CRATER_PART_GAP = 1              -- separación entre partes vecinas
local CRATER_BURIAL_MIN = 1.0          -- mínimo de studs enterrados (cada parte elige uno distinto)
local CRATER_BURIAL_MAX = 2.0          -- máximo de studs enterrados
local CRATER_TILT = -15                -- grados de inclinación mirando al clon
local SMALL_PART_INTERVAL = 0.3        -- cada cuánto se crea una parte pequeña
local R15_IDLE_ANIMATION = "507766666"
local R6_IDLE_ANIMATION = "180435571"

local impactRandom = Random.new()

local function getSurfaceColorAndMaterial(result)
	local instance = result.Instance

	if instance:IsA("Terrain") then
		return workspace.Terrain:GetMaterialColor(result.Material), result.Material
	end

	return instance.Color, instance.Material
end

-- Busca la superficie más cercana al origen (suelo, pared, etc.)
local function findSurface(origin, preferredDirection, ignoreList)
	local params = RaycastParams.new()
	params.FilterType = Enum.RaycastFilterType.Exclude
	params.FilterDescendantsInstances = ignoreList
	params.RespectCanCollide = true

	local directions = {
		Vector3.new(0, -1, 0),
		Vector3.new(1, 0, 0),
		Vector3.new(-1, 0, 0),
		Vector3.new(0, 0, 1),
		Vector3.new(0, 0, -1),
		Vector3.new(0, 1, 0),
	}

	if preferredDirection and preferredDirection.Magnitude > 0.1 then
		table.insert(directions, 1, preferredDirection.Unit)
	end

	local best = nil
	local bestDistance = math.huge

	for _, direction in ipairs(directions) do
		local result = workspace:Raycast(origin, direction * 8, params)
		if result then
			local distance = (result.Position - origin).Magnitude
			if distance < bestDistance then
				best = result
				bestDistance = distance
			end
		end
	end

	return best
end

-- Convierte al clon en ragdoll. Devuelve una función para deshacerlo.
local function ragdollClone(clone, humanoid)
	humanoid.PlatformStand = true
	humanoid:ChangeState(Enum.HumanoidStateType.Physics)

	local created = {}
	local motors = {}

	for _, descendant in ipairs(clone:GetDescendants()) do
		if descendant:IsA("Motor6D") and descendant.Part0 and descendant.Part1 then
			-- La unión del HumanoidRootPart se conserva
			if descendant.Part0.Name ~= "HumanoidRootPart" and descendant.Part1.Name ~= "HumanoidRootPart" then
				local attachment0 = Instance.new("Attachment")
				attachment0.CFrame = descendant.C0
				attachment0.Parent = descendant.Part0

				local attachment1 = Instance.new("Attachment")
				attachment1.CFrame = descendant.C1
				attachment1.Parent = descendant.Part1

				local socket = Instance.new("BallSocketConstraint")
				socket.Attachment0 = attachment0
				socket.Attachment1 = attachment1
				-- Límites amplios para que brazos y piernas se muevan sueltos (cuello y cintura un poco más limitados)
				local upperAngle = 110
				local twistAngle = 80
				if descendant.Name == "Neck" or descendant.Name == "Waist" then
					upperAngle = 60
					twistAngle = 40
				end

				socket.LimitsEnabled = true
				socket.UpperAngle = upperAngle
				socket.TwistLimitsEnabled = true
				socket.TwistLowerAngle = -twistAngle
				socket.TwistUpperAngle = twistAngle
				socket.Parent = descendant.Part0

				-- Las partes unidas no chocan entre sí
				local noCollision = Instance.new("NoCollisionConstraint")
				noCollision.Part0 = descendant.Part0
				noCollision.Part1 = descendant.Part1
				noCollision.Parent = descendant.Part0

				table.insert(created, attachment0)
				table.insert(created, attachment1)
				table.insert(created, socket)
				table.insert(created, noCollision)

				descendant.Enabled = false
				table.insert(motors, descendant)
			end
		end
	end

	return function()
		for _, object in ipairs(created) do
			if object and object.Parent then
				object:Destroy()
			end
		end
		for _, motor in ipairs(motors) do
			if motor and motor.Parent then
				motor.Enabled = true
			end
		end
	end
end

local function createCrater(folder, center, normal, color, material)
	local base = CFrame.lookAt(center, center + normal) -- sus ejes X/Y son el plano de la superficie
	local radius = math.max(
		CRATER_CLONE_DISTANCE + CRATER_PART_SIZE / 2,
		(CRATER_PART_SIZE + CRATER_PART_GAP) / (2 * math.sin(math.pi / CRATER_PART_COUNT))
	)

	for index = 1, CRATER_PART_COUNT do
		local angle = (index - 1) * (2 * math.pi / CRATER_PART_COUNT)
		local offset = base.RightVector * math.cos(angle) * radius + base.UpVector * math.sin(angle) * radius

		-- Cada parte está enterrada una cantidad distinta (sin pasarse)
		local burial = impactRandom:NextNumber(CRATER_BURIAL_MIN, CRATER_BURIAL_MAX)
		local lift = normal * (CRATER_PART_SIZE / 2 - burial)

		local position = center + offset + lift
		local lookTarget = center + lift

		local part = Instance.new("Part")
		part.Name = "CraterPart"
		part.Size = Vector3.one * CRATER_PART_SIZE
		part.Anchored = true
		part.CanCollide = false
		part.CanQuery = false
		part.CanTouch = false
		part.Color = color
		part.Material = material
		-- Mirando al clon, inclinado 15 grados
		part.CFrame = CFrame.lookAt(position, lookTarget, normal) * CFrame.Angles(math.rad(CRATER_TILT), 0, 0)
		part.Parent = folder
	end
end

local function createSmallPart(folder, position, normal, color, material)
	local base = CFrame.lookAt(position, position + normal)
	local jitter = base.RightVector * impactRandom:NextNumber(-1.5, 1.5)
		+ base.UpVector * impactRandom:NextNumber(-1.5, 1.5)

	local part = Instance.new("Part")
	part.Name = "ImpactDebris"
	part.Size = Vector3.new(
		impactRandom:NextNumber(0.6, 1.6),
		impactRandom:NextNumber(0.6, 1.6),
		impactRandom:NextNumber(0.6, 1.6)
	)
	part.Anchored = true
	part.CanCollide = false
	part.CanQuery = false
	part.CanTouch = false
	part.Color = color
	part.Material = material
	-- Centro sobre la superficie: queda medio enterrada
	part.CFrame = CFrame.new(position + jitter) * CFrame.Angles(
		math.rad(impactRandom:NextNumber(0, 360)),
		math.rad(impactRandom:NextNumber(0, 360)),
		math.rad(impactRandom:NextNumber(0, 360))
	)
	part.Parent = folder
end

local function spawnUpSmoke(folder, position, color)
	local resources = ReplicatedStorage:FindFirstChild("Resources")
	local template = resources and resources:FindFirstChild("UpSmoke")
	if not template then return end

	-- Pieza fija e invisible: el humo se queda en esa posición y no sigue al clon
	local holder = Instance.new("Part")
	holder.Name = "UpSmokeHolder"
	holder.Size = Vector3.one
	holder.Transparency = 1
	holder.Anchored = true
	holder.CanCollide = false
	holder.CanQuery = false
	holder.CanTouch = false
	holder.CFrame = CFrame.new(position)
	holder.Parent = folder

	local results = {}
	placeVfxOnPart(template, holder, results)

	for _, object in ipairs(results) do
		local emitters = object:GetDescendants()
		table.insert(emitters, object)

		for _, emitter in ipairs(emitters) do
			if emitter:IsA("ParticleEmitter") then
				emitter.Color = ColorSequence.new(color)
			end
		end

		emitBurst(object, 20)
	end

	task.delay(4, function()
		if holder and holder.Parent then
			holder:Destroy()
		end
	end)
end

local function launchWallComboClone(cloneHandle, token, playerRoot)
	local clone = cloneHandle and cloneHandle.instance
	if not clone or not clone.Parent then return end

	local cloneRoot = clone:FindFirstChild("HumanoidRootPart")
	local cloneHumanoid = clone:FindFirstChildOfClass("Humanoid")
	if not cloneRoot or not cloneHumanoid then return end

	-- Mientras dure esta secuencia, el clon no se recrea ni expira por su tiempo de vida normal
	cloneHandle.noRespawn = true
	cloneHandle.keepAlive = true

	-- Espera un poco antes de mandar volando al clon
	task.wait(CLONE_LAUNCH_DELAY)
	if token ~= sequence or cloneHandle.instance ~= clone or not clone.Parent then return end

	if wallComboImpactFolder then
		wallComboImpactFolder:Destroy()
	end
	local folder = Instance.new("Folder")
	folder.Name = "WallComboImpact"
	folder.Parent = workspace
	wallComboImpactFolder = folder

	local torso = clone:FindFirstChild("Torso") or clone:FindFirstChild("UpperTorso") or cloneRoot
	local playerCharacter = player.Character
	local ignoreList = { clone, folder }
	if playerCharacter then
		table.insert(ignoreList, playerCharacter)
	end

	local function isAlive()
		return token == sequence
			and cloneHandle.instance == clone
			and clone.Parent ~= nil
			and folder.Parent ~= nil
	end

	-- Detener animaciones del clon (el ragdoll las reemplaza)
	local animator = cloneHumanoid:FindFirstChildOfClass("Animator")
	if animator then
		for _, track in ipairs(animator:GetPlayingAnimationTracks()) do
			track:Stop(0)
		end
	end

	local restoreJoints = ragdollClone(clone, cloneHumanoid)

	-- Partes del clon con colisión (menos el HumanoidRootPart) y sin chocar con el jugador
	local cloneParts = {}
	for _, child in ipairs(clone:GetChildren()) do
		if child:IsA("BasePart") then
			table.insert(cloneParts, child)
			if child ~= cloneRoot then
				child.CanCollide = true
			end
		end
	end

	if playerCharacter then
		for _, clonePart in ipairs(cloneParts) do
			for _, playerPart in ipairs(playerCharacter:GetChildren()) do
				if playerPart:IsA("BasePart") then
					local noCollision = Instance.new("NoCollisionConstraint")
					noCollision.Part0 = clonePart
					noCollision.Part1 = playerPart
					noCollision.Parent = clonePart
				end
			end
		end
	end

	-- Salir volando hacia la IZQUIERDA del jugador
	local leftDirection = -playerRoot.CFrame.RightVector
	leftDirection = Vector3.new(leftDirection.X, 0, leftDirection.Z)
	leftDirection = leftDirection.Magnitude > 0 and leftDirection.Unit or Vector3.new(-1, 0, 0)

	local launchTime = os.clock()
	cloneRoot.Anchored = false

	local velocity = leftDirection * CLONE_FLY_SPEED + Vector3.new(0, CLONE_FLY_UP, 0)
	local mainAssembly = cloneRoot:GetRootPart()
	for _, part in ipairs(cloneParts) do
		local isLimb = part:GetRootPart() ~= mainAssembly

		-- Brazos, piernas y cabeza reciben velocidades distintas para que se muevan sueltos y no rígidos
		local variation = isLimb
			and Vector3.new(
				impactRandom:NextNumber(-14, 14),
				impactRandom:NextNumber(-8, 14),
				impactRandom:NextNumber(-14, 14)
			)
			or Vector3.zero
		local spin = isLimb and 25 or 8

		part.AssemblyLinearVelocity = velocity + variation
		part.AssemblyAngularVelocity = Vector3.new(
			impactRandom:NextNumber(-spin, spin),
			impactRandom:NextNumber(-spin, spin),
			impactRandom:NextNumber(-spin, spin)
		)
	end

	-- Detección de toques (suelo, pared o lo que sea)
	local touched = false
	local connections = {}

	local function isValidSurface(part)
		if not part or not part.Parent then return false end
		if not part.CanCollide then return false end
		if part:IsDescendantOf(clone) or part:IsDescendantOf(folder) then return false end

		local model = part:FindFirstAncestorOfClass("Model")
		if model and model:FindFirstChildOfClass("Humanoid") then return false end

		return true
	end

	for _, part in ipairs(cloneParts) do
		table.insert(connections, part.Touched:Connect(function(other)
			if os.clock() - launchTime < CLONE_TOUCH_GRACE then return end
			if isValidSurface(other) then
				touched = true
			end
		end))
	end

	local function disconnectAll()
		for _, connection in ipairs(connections) do
			connection:Disconnect()
		end
		table.clear(connections)
	end

	-- Espera un toque válido; acceptFn(surface) decide si cuenta. Devuelve la superficie o nil.
	local function waitForSurface(timeout, acceptFn)
		local startedAt = os.clock()
		touched = false

		while isAlive() and os.clock() - startedAt < timeout do
			if touched then
				touched = false
				local surface = findSurface(torso.Position, torso.AssemblyLinearVelocity, ignoreList)
				if surface and (not acceptFn or acceptFn(surface)) then
					return surface
				end
			end
			task.wait()
		end

		return nil
	end

	-- 1) Primer impacto: cráter, sonido y humo
	local firstSurface = waitForSurface(CLONE_MAX_TIME, nil)
	local firstWasWall = false

	if firstSurface and isAlive() then
		local color, material = getSurfaceColorAndMaterial(firstSurface)
		local normal = firstSurface.Normal
		local torsoPosition = torso.Position
		firstWasWall = normal.Y < 0.7

		-- Centro del cráter: la posición del torso proyectada sobre la superficie
		local center = torsoPosition - normal * (torsoPosition - firstSurface.Position):Dot(normal)
		createCrater(folder, center, normal, color, material)

		-- Sonido en el clon
		local sound = Instance.new("Sound")
		sound.SoundId = "rbxassetid://" .. IMPACT_SOUND_ID
		sound.Volume = 2
		sound.Parent = torso
		sound.Ended:Connect(function()
			sound:Destroy()
		end)
		sound:Play()

		-- Humo fijo en la posición del torso, del color de la superficie
		spawnUpSmoke(folder, torsoPosition, color)
	end

	-- 2) Si fue pared, esperar a que toque de nuevo el suelo u otra superficie
	if firstSurface and firstWasWall and isAlive() then
		waitForSurface(6, function(surface)
			return surface.Normal.Y > 0.7 or surface.Instance ~= firstSurface.Instance
		end)
	end

	-- 3) Partes pequeñas enterradas cada 0.3 s hasta que el clon deje de moverse
	if firstSurface then
		local slowTime = 0

		while isAlive() and os.clock() - launchTime < CLONE_MAX_TIME do
			local surface = findSurface(torso.Position, Vector3.new(0, -1, 0), ignoreList)
			if surface then
				local color, material = getSurfaceColorAndMaterial(surface)
				createSmallPart(folder, surface.Position, surface.Normal, color, material)
			end

			task.wait(SMALL_PART_INTERVAL)

			if torso.AssemblyLinearVelocity.Magnitude < CLONE_SETTLE_SPEED then
				slowTime += SMALL_PART_INTERVAL
			else
				slowTime = 0
			end

			if slowTime >= CLONE_SETTLE_TIME then
				break
			end
		end
	end

	disconnectAll()
	if not isAlive() then return end

	-- 4) Levantarse normal (sin ragdoll)
	restoreJoints()

	local rootPosition = cloneRoot.Position
	local groundParams = RaycastParams.new()
	groundParams.FilterType = Enum.RaycastFilterType.Exclude
	groundParams.FilterDescendantsInstances = ignoreList
	groundParams.RespectCanCollide = true

	local groundResult = workspace:Raycast(torso.Position, Vector3.new(0, -15, 0), groundParams)
	local rootHeight = (cloneHumanoid.RigType == Enum.HumanoidRigType.R15)
		and (cloneHumanoid.HipHeight + cloneRoot.Size.Y / 2)
		or 3
	local standY = groundResult and (groundResult.Position.Y + rootHeight) or rootPosition.Y
	local standPosition = Vector3.new(rootPosition.X, standY, rootPosition.Z)

	-- De pie, mirando hacia el jugador
	local lookAtPlayer = Vector3.new(playerRoot.Position.X, standPosition.Y, playerRoot.Position.Z)
	local standCFrame = (lookAtPlayer - standPosition).Magnitude > 0.1
		and CFrame.lookAt(standPosition, lookAtPlayer)
		or CFrame.new(standPosition)

	cloneRoot.Anchored = true
	clone:PivotTo(standCFrame)
	cloneHumanoid.PlatformStand = false

	local idleId = (cloneHumanoid.RigType == Enum.HumanoidRigType.R15) and R15_IDLE_ANIMATION or R6_IDLE_ANIMATION
	pcall(function()
		local idleAnimation = Instance.new("Animation")
		idleAnimation.AnimationId = "rbxassetid://" .. idleId
		local idleTrack = (animator or cloneHumanoid:FindFirstChildOfClass("Animator")):LoadAnimation(idleAnimation)
		idleAnimation:Destroy()
		idleTrack.Looped = true
		idleTrack:Play(0.2)
	end)

	-- 5) Esperar unos 2 segundos y eliminar el clon
	local waitedUp = 0
	while waitedUp < CLONE_GETUP_WAIT and isAlive() do
		waitedUp += task.wait()
	end
	if not isAlive() then return end

	cloneHandle.destroy()

	-- 6) El cráter y las partes se mantienen unos segundos más y luego se eliminan
	task.wait(IMPACT_KEEP_TIME)
	if not folder.Parent then return end

	for _, part in ipairs(folder:GetChildren()) do
		if part:IsA("BasePart") then
			TweenService:Create(part, TweenInfo.new(0.6), { Transparency = 1 }):Play()
		end
	end

	task.wait(0.6)

	if folder.Parent then
		folder:Destroy()
	end
	if wallComboImpactFolder == folder then
		wallComboImpactFolder = nil
	end
end

local function playWallComboVfx(cloneHandle, token)
	local character = player.Character
	if not character then return end

	local playerTorso = getSoundParent(character)
	local playerRoot = character:FindFirstChild("HumanoidRootPart")

	-- Siempre se busca en el clon ACTUAL (por si se recreó)
	local function getCloneRoot()
		local clone = cloneHandle and cloneHandle.instance
		return clone and clone.Parent and clone:FindFirstChild("HumanoidRootPart") or nil
	end

	local function getCloneTorso()
		local clone = cloneHandle and cloneHandle.instance
		if not clone or not clone.Parent then return nil end
		return clone:FindFirstChild("Torso")
			or clone:FindFirstChild("UpperTorso")
			or clone:FindFirstChild("HumanoidRootPart")
	end

	local function getPlayerTorso()
		return playerTorso
	end

	local state = { stopped = false, objects = {} }

	local function track(list)
		for _, object in ipairs(list) do
			table.insert(state.objects, object)
		end
	end

	local function startLoop(name, getTarget, interval, lifetime)
		task.spawn(function()
			while token == sequence and not state.stopped do
				local target = getTarget()
				if target and target.Parent then
					track(spawnWallComboVfx(name, target, lifetime, 1, token))
				end
				task.wait(interval)
			end
		end)
	end

	-- Al empezar: slam en el HumanoidRootPart del clon
	local cloneRoot = getCloneRoot()
	if cloneRoot then
		spawnWallComboVfx("slam", cloneRoot, WALL_COMBO_SLAM_LIFETIME, 3, token)
	end

	-- Bucles (solo después de 3 s): hold en el torso del clon y UserAura en el torso del jugador
	task.delay(WALL_COMBO_LOOPS_DELAY, function()
		if token ~= sequence or state.stopped then return end

		if cloneHandle then
			startLoop("hold", getCloneTorso, WALL_COMBO_HOLD_INTERVAL, WALL_COMBO_HOLD_LIFETIME)
		end
		startLoop("UserAura", getPlayerTorso, WALL_COMBO_AURA_INTERVAL, WALL_COMBO_AURA_LIFETIME)
	end)

	-- A los 3 s: feet en la pierna derecha del jugador (dura 3 s)
	task.delay(WALL_COMBO_FEET_DELAY, function()
		if token ~= sequence then return end

		local leg = getRightLeg(character)
		if leg then
			track(spawnWallComboVfx("feet", leg, WALL_COMBO_FEET_LIFETIME, 3, token))
		end
	end)

	-- A los 6 s: eliminar feet/hold/UserAura y poner FinalImpact en el HumanoidRootPart del jugador
	task.delay(WALL_COMBO_FINAL_DELAY, function()
		state.stopped = true

		for _, object in ipairs(state.objects) do
			if object and object.Parent then
				object:Destroy()
			end
		end
		table.clear(state.objects)

		if token ~= sequence then return end

		if playerRoot and playerRoot.Parent then
			-- Rotado 90° a la izquierda de forma instantánea
			spawnWallComboVfx("FinalImpact", playerRoot, WALL_COMBO_FINAL_LIFETIME, 3, token, CFrame.Angles(0, math.rad(90), 0))

			-- El clon sale volando a la izquierda del jugador (ragdoll)
			task.spawn(launchWallComboClone, cloneHandle, token, playerRoot)
		end
	end)
end

