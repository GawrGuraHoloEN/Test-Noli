local WALL_COMBO_SLAM_LIFETIME = 3          -- slam (en el HumanoidRootPart del clon)
local WALL_COMBO_FEET_DELAY = 3             -- feet aparece a los 3 s...
local WALL_COMBO_FEET_LIFETIME = 3          -- ...y dura 3 s
local WALL_COMBO_LOOPS_DELAY = 3         -- hold y UserAura empiezan a los 3 s de la animación
local WALL_COMBO_HOLD_INTERVAL = 0.02       -- hold (torso del clon): cada cuánto se repite
local WALL_COMBO_HOLD_LIFETIME = 0.1        -- y cuánto dura cada clon
local WALL_COMBO_AURA_INTERVAL = 0.01       -- UserAura (torso del jugador): cada cuánto se repite
local WALL_COMBO_AURA_LIFETIME = 0.1        -- y cuánto dura cada clon
