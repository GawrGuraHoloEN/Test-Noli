----------------------------------------------------------------
-- Personaje
----------------------------------------------------------------

local function getCharacter()
	local character = player.Character or player.CharacterAdded:Wait()

	local humanoid = character:FindFirstChildOfClass("Humanoid")
		or character:WaitForChild("Humanoid")

	local animator = humanoid:FindFirstChildOfClass("Animator")

	if not animator then
		animator = Instance.new("Animator")
		animator.Parent = humanoid
	end

	return character, humanoid, animator
end

local function getRoot(character)
	return character:FindFirstChild("HumanoidRootPart")
		or character:WaitForChild("HumanoidRootPart")
end

local function getSoundParent(character)
	return character:FindFirstChild("Torso")
		or character:FindFirstChild("UpperTorso")
		or getRoot(character)
end

local function getKJEffects()
	local resources = ReplicatedStorage:FindFirstChild("Resources")
	if not resources then
		return nil
	end

	return resources:FindFirstChild("KJEffects")
end

----------------------------------------------------------------
-- Control del jugador (20 Series Alt y 20-20-20 Dropkick)
----------------------------------------------------------------

local function getPlayerControls()
	if playerControls then
		return playerControls
	end

	local playerScripts = player:FindFirstChild("PlayerScripts")
	if not playerScripts then
		return nil
	end

	local playerModule = playerScripts:FindFirstChild("PlayerModule")
	if not playerModule then
		return nil
	end

	local success, module = pcall(require, playerModule)

	if success and module then
		playerControls = module:GetControls()
		return playerControls
	end

	return nil
end

local function stopForcedMovement()
	forcedMovementToken += 1

	if forcedMovementConnection then
		forcedMovementConnection:Disconnect()
		forcedMovementConnection = nil
	end

	local character = player.Character
	local humanoid = character and character:FindFirstChildOfClass("Humanoid")

	if humanoid then
		if savedWalkSpeed ~= nil then
			humanoid.WalkSpeed = savedWalkSpeed
		end

		if savedAutoRotate ~= nil then
			humanoid.AutoRotate = savedAutoRotate
		end
	end

	if savedAnchored ~= nil then
		local rootPart = character and character:FindFirstChild("HumanoidRootPart")
		if rootPart then
			rootPart.Anchored = savedAnchored
		end
	end

	if savedCameraMaxZoom ~= nil then
		player.CameraMaxZoomDistance = savedCameraMaxZoom
		savedCameraMaxZoom = nil
	end
	if savedCameraMinZoom ~= nil then
		player.CameraMinZoomDistance = savedCameraMinZoom
		savedCameraMinZoom = nil
	end

	savedWalkSpeed = nil
	savedAutoRotate = nil
	savedAnchored = nil

	local controls = getPlayerControls()
	if controls then
		controls:Enable()
	end
end

local function force20SeriesAltMovement(track, token)
	stopForcedMovement()

	local character, humanoid, animator = getCharacter()
	local root = getRoot(character)

	savedWalkSpeed = humanoid.WalkSpeed
	savedAutoRotate = humanoid.AutoRotate

	local controls = getPlayerControls()
	if controls then
		controls:Disable()
	end

	humanoid.WalkSpeed = 5
	humanoid.AutoRotate = true -- permite girar con primera persona / shiftlock

	forcedMovementToken += 1
	local movementToken = forcedMovementToken
	local startTime = os.clock()
	local movementFinished = false

	-- Si la animacion se interrumpe antes de terminar, se cancela todo (igual que el Dropkick)
	local trackStoppedConn = nil
	trackStoppedConn = track.Stopped:Connect(function()
		if trackStoppedConn then
			trackStoppedConn:Disconnect()
			trackStoppedConn = nil
		end

		local isNaturalEnd = (track.Length > 0) and (track.TimePosition >= track.Length - 0.15)
		if not isNaturalEnd and token == sequence and movementToken == forcedMovementToken then
			local currentStop = stopCurrent
			if currentStop then
				currentStop()
			end
		end
	end)

	forcedMovementConnection = RunService.RenderStepped:Connect(function()
		local elapsed = os.clock() - startTime

		if token ~= sequence
			or movementToken ~= forcedMovementToken
			or not character.Parent
			or not humanoid.Parent
			or not root.Parent
			or not track.IsPlaying then

			if trackStoppedConn then
				trackStoppedConn:Disconnect()
				trackStoppedConn = nil
			end

			stopForcedMovement()
			return
		end

		-- Ninguna otra animacion se combina con esta mientras dure
		for _, otherTrack in ipairs(animator:GetPlayingAnimationTracks()) do
			if otherTrack ~= track then
				otherTrack:Stop(0)
				otherTrack:AdjustWeight(0)
			end
		end

		if elapsed < 1.8 then
			humanoid.WalkSpeed = 5
			humanoid.AutoRotate = true
			humanoid:Move(root.CFrame.LookVector, false)
		elseif not movementFinished then
			-- Termina el avance forzado: se devuelve el control, pero se siguen bloqueando otras animaciones
			movementFinished = true

			if savedWalkSpeed ~= nil then
				humanoid.WalkSpeed = savedWalkSpeed
			end
			if savedAutoRotate ~= nil then
				humanoid.AutoRotate = savedAutoRotate
			end

			local c = getPlayerControls()
			if c then
				c:Enable()
			end
		end
	end)
end

local function forceDropkickMovement(track, token)
	stopForcedMovement()

	local character, humanoid, animator = getCharacter()
	local root = getRoot(character)

	savedWalkSpeed = humanoid.WalkSpeed
	savedAutoRotate = humanoid.AutoRotate

	local controls = getPlayerControls()
	if controls then
		controls:Disable()
	end

	forcedMovementToken += 1
	local movementToken = forcedMovementToken
	local startTime = os.clock()
	
	local hasStartedDash = false
	local lastSpeedlineTime = 0
	local activeVfx = {} 
	local activeOffsets = {} -- distancia hacia adelante de cada VFX persistente
	
	local thingVfxInstance = nil 
	local hasDisabledThing = false

	-- Fade de partículas durante el segundo extra
	local fadeStarted = false
	local fadeStartTime = 0
	local fadeEmitters = {}

	-- Cámara: acercamiento suave + bloqueo del zoom
	local cameraZoomStarted = false
	local cameraZoomStartTime = 0
	local cameraZoomFrom = 0
	local cameraZoomTarget = 0

	local trackStoppedConn = nil
	trackStoppedConn = track.Stopped:Connect(function()
		if trackStoppedConn then
			trackStoppedConn:Disconnect()
			trackStoppedConn = nil
		end

		local isNaturalEnd = (track.Length > 0) and (track.TimePosition >= track.Length - 0.15)
		if not isNaturalEnd and token == sequence and movementToken == forcedMovementToken then
			local currentStop = stopCurrent
			if currentStop then
				currentStop()
			end
		end
	end)

	forcedMovementConnection = RunService.RenderStepped:Connect(function()
		local elapsed = os.clock() - startTime

		if token ~= sequence
			or movementToken ~= forcedMovementToken
			or elapsed >= DROPKICK_DASH_END + DROPKICK_EXTRA_TIME
			or not character.Parent
			or not humanoid.Parent
			or not root.Parent
			or not track.IsPlaying then

			if trackStoppedConn then
				trackStoppedConn:Disconnect()
				trackStoppedConn = nil
			end

			for _, vfx in ipairs(activeVfx) do
				if vfx and vfx.Parent then
					vfx:Destroy()
				end
			end

			stopForcedMovement()
			return
		end

		for _, otherTrack in ipairs(animator:GetPlayingAnimationTracks()) do
			if otherTrack ~= track then
				otherTrack:Stop(0)
				otherTrack:AdjustWeight(0)
			end
		end

		-- 1 s antes del movimiento forzado: acercar la cámara suavemente y bloquear el zoom
		if elapsed >= DROPKICK_CAMERA_START then
			local camera = workspace.CurrentCamera

			if not cameraZoomStarted and camera then
				cameraZoomStarted = true
				cameraZoomStartTime = os.clock()
				cameraZoomFrom = (camera.CFrame.Position - camera.Focus.Position).Magnitude
				cameraZoomTarget = math.min(DROPKICK_CAMERA_DISTANCE, cameraZoomFrom)

				savedCameraMaxZoom = player.CameraMaxZoomDistance
				savedCameraMinZoom = player.CameraMinZoomDistance
			end

			if cameraZoomStarted then
				local alpha = math.clamp((os.clock() - cameraZoomStartTime) / DROPKICK_CAMERA_ZOOM_TIME, 0, 1)
				local eased = TweenService:GetValue(alpha, Enum.EasingStyle.Sine, Enum.EasingDirection.Out)
				local distance = cameraZoomFrom + (cameraZoomTarget - cameraZoomFrom) * eased

				-- El máximo baja poco a poco (acerca la cámara) y se queda ahí, así no se puede alejar
				player.CameraMinZoomDistance = math.min(savedCameraMinZoom or 0.5, distance)
				player.CameraMaxZoomDistance = distance
			end
		end

		if elapsed < 2 then
			humanoid.WalkSpeed = 0
			humanoid.AutoRotate = true 
		else
			if not hasStartedDash then
				hasStartedDash = true
				
				local kjEffects = getKJEffects()
				if kjEffects then
					local fxStuff = kjEffects:FindFirstChild("speedlinesandstuff")
					local fxThing = fxStuff and fxStuff:FindFirstChild("thespeedthingunderultik")

					local function spawnPersistentVfx(template, forwardOffset)
						if not template then return nil end
						forwardOffset = forwardOffset or 0
						local clone = template:Clone()
						
						if clone:IsA("Attachment") then
							clone.Parent = root
							clone.Position = Vector3.new(0, 0, -forwardOffset)
						elseif clone:IsA("BasePart") then
							clone.CFrame = root.CFrame * CFrame.new(0, 0, -forwardOffset)
							clone.Parent = workspace
						else
							clone.Parent = root
						end

						activeOffsets[clone] = forwardOffset
						
						for _, em in ipairs(clone:GetDescendants()) do
							if em:IsA("ParticleEmitter") then
								em.Enabled = true
							end
						end
						
						table.insert(currentVfx, clone)
						table.insert(activeVfx, clone)
						return clone
					end

					spawnPersistentVfx(fxStuff, DROPKICK_SPEEDLINESSTUFF_OFFSET)
					thingVfxInstance = spawnPersistentVfx(fxThing)
				end
			end

			if elapsed >= 4 and not hasDisabledThing then
				hasDisabledThing = true
				if thingVfxInstance and thingVfxInstance.Parent then
					for _, emitter in ipairs(thingVfxInstance:GetDescendants()) do
						if emitter:IsA("ParticleEmitter") then
							emitter.Enabled = false
						end
					end
				end
			end

			local inExtraTime = elapsed >= DROPKICK_DASH_END

			if inExtraTime then
				-- Segundo extra: los 2 VFX persistentes (no speedlines) pasan de visibles a invisibles suavemente
				if not fadeStarted then
					fadeStarted = true
					fadeStartTime = os.clock()

					for _, vfx in ipairs(activeVfx) do
						if vfx and vfx.Parent then
							for _, descendant in ipairs(vfx:GetDescendants()) do
								-- GetDescendants busca a cualquier profundidad: ParticleEmitter y Beam
								if descendant:IsA("ParticleEmitter") or descendant:IsA("Beam") then
									table.insert(fadeEmitters, {
										emitter = descendant,
										keypoints = descendant.Transparency.Keypoints,
									})
								end
							end
						end
					end
				end

				local alpha = math.clamp((os.clock() - fadeStartTime) / DROPKICK_EXTRA_TIME, 0, 1)

				for _, data in ipairs(fadeEmitters) do
					if data.emitter.Parent then
						local newKeypoints = {}
						for index, keypoint in ipairs(data.keypoints) do
							newKeypoints[index] = NumberSequenceKeypoint.new(
								keypoint.Time,
								keypoint.Value + (1 - keypoint.Value) * alpha,
								keypoint.Envelope
							)
						end
						data.emitter.Transparency = NumberSequence.new(newKeypoints)
					end
				end
			end

			humanoid.WalkSpeed = inExtraTime and DROPKICK_EXTRA_WALKSPEED or 250
			humanoid.AutoRotate = true 
			humanoid:Move(root.CFrame.LookVector, false)

			for _, vfx in ipairs(activeVfx) do
				if vfx and vfx.Parent and vfx:IsA("BasePart") then
					vfx.CFrame = root.CFrame * CFrame.new(0, 0, -(activeOffsets[vfx] or 0))
				end
			end

			if not inExtraTime and os.clock() - lastSpeedlineTime >= 0.01 then
				lastSpeedlineTime = os.clock()
				
				local kjEffects = getKJEffects()
				local fxSpeedlines = kjEffects and kjEffects:FindFirstChild("speedlines")
				
				if fxSpeedlines then
					local slClone = fxSpeedlines:Clone()
					if slClone:IsA("Attachment") then
						slClone.Parent = root
						slClone.Position = Vector3.zero
					elseif slClone:IsA("BasePart") then
						slClone.CFrame = root.CFrame
						slClone.Parent = workspace
					else
						slClone.Parent = root
					end
					
					table.insert(currentVfx, slClone)
					Debris:AddItem(slClone, 0.2)
					
					for _, emitter in ipairs(slClone:GetDescendants()) do
						if emitter:IsA("ParticleEmitter") then
							emitter.Enabled = true
							emitter:Emit(3)
							emitter.Enabled = false
						end
					end
				end
			end
		end
	end)
end

local function freezePlayerDuringAnimation(track, token, unanchorAfter)
	stopForcedMovement()

	local character, humanoid = getCharacter()
	local root = getRoot(character)

	savedWalkSpeed = humanoid.WalkSpeed
	savedAutoRotate = humanoid.AutoRotate

	local controls = getPlayerControls()
	if controls then
		controls:Disable()
	end

	humanoid.WalkSpeed = 0
	humanoid.AutoRotate = false

	-- Anclar al jugador
	savedAnchored = root.Anchored
	root.Anchored = true

	forcedMovementToken += 1
	local movementToken = forcedMovementToken
	local lockedRotation = root.CFrame.Rotation
	local bindName = "FreezePlayerDuringAnimation"
	local startTime = os.clock()
	local hasUnanchored = false

	-- Se ejecuta con la prioridad más tardía para que ni shiftlock ni primera persona puedan girar al personaje
	RunService:BindToRenderStep(bindName, Enum.RenderPriority.Last.Value, function()
		if token ~= sequence
			or movementToken ~= forcedMovementToken
			or not character.Parent
			or not humanoid.Parent
			or not root.Parent
			or not track.IsPlaying then

			stopForcedMovement()
			return
		end

		humanoid.WalkSpeed = 0
		humanoid.AutoRotate = false

		-- Pasado el tiempo indicado, el jugador se desancla (sigue congelado hasta que acabe la animación)
		if unanchorAfter and os.clock() - startTime >= unanchorAfter then
			if not hasUnanchored then
				hasUnanchored = true
				root.Anchored = false
			end
		else
			root.Anchored = true
		end

		root.CFrame = CFrame.new(root.Position) * lockedRotation
		root.AssemblyAngularVelocity = Vector3.zero
	end)

	-- stopForcedMovement() llama a :Disconnect(), así que se desvincula el RenderStep aquí
	forcedMovementConnection = {
		Disconnect = function()
			pcall(function()
				RunService:UnbindFromRenderStep(bindName)
			end)
		end,
	}
end

-- Impide que el jugador se mueva mientras la animación esté sonando (no toca la rotación ni la cámara)
local function freezeMovementDuringAnimation(track, token)
	stopForcedMovement()

	local character, humanoid = getCharacter()

	savedWalkSpeed = humanoid.WalkSpeed

	local controls = getPlayerControls()
	if controls then
		controls:Disable()
	end

	humanoid.WalkSpeed = 0

	forcedMovementToken += 1
	local movementToken = forcedMovementToken

	forcedMovementConnection = RunService.RenderStepped:Connect(function()
		if token ~= sequence
			or movementToken ~= forcedMovementToken
			or not character.Parent
			or not humanoid.Parent
			or not track.IsPlaying then

			-- Terminó o se interrumpió la animación: se devuelve el movimiento
			stopForcedMovement()
			return
		end

		humanoid.WalkSpeed = 0
		humanoid:Move(Vector3.zero, false)
	end)
end

