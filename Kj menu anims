local dragging = false
local dragStart
local startPosition

local function updateDrag(input)
	local delta = input.Position - dragStart
	local camera = workspace.CurrentCamera
	local viewport = camera and camera.ViewportSize or Vector2.new(1920, 1080)
	local menuSize = frame.AbsoluteSize

	local maxX = math.max(0, viewport.X - menuSize.X)
	local maxY = math.max(0, viewport.Y - menuSize.Y)

	local newX = math.clamp(startPosition.X.Offset + delta.X, 0, maxX)
	local newY = math.clamp(startPosition.Y.Offset + delta.Y, 0, maxY)

	frame.Position = UDim2.fromOffset(newX, newY)
end

header.InputBegan:Connect(function(input)
	if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
		dragging = true
		dragStart = input.Position
		startPosition = frame.Position

		input.Changed:Connect(function()
			if input.UserInputState == Enum.UserInputState.End then
				dragging = false
			end
		end)
	end
end)

UserInputService.InputChanged:Connect(function(input)
	if not dragging then return end
	if input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch then
		updateDrag(input)
	end
end)

