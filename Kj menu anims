local function emitVfx(name, lifetime, token)
	if token ~= sequence then return nil end

	local kjEffects = getKJEffects()
	local template = kjEffects and kjEffects:FindFirstChild(name)

	if not template then return nil end

	local character = player.Character or player.CharacterAdded:Wait()
	local root = getRoot(character)
	local object = template:Clone()

	if object:IsA("Attachment") then
		object.Parent = root
		object.Position = Vector3.zero
	elseif object:IsA("BasePart") then
		object.CFrame = root.CFrame
		object.Parent = workspace
	else
		object.Parent = root
	end

	table.insert(currentVfx, object)
	Debris:AddItem(object, lifetime)

	for _, emitter in ipairs(object:GetDescendants()) do
		if emitter:IsA("ParticleEmitter") then
			emitter.Enabled = true
			emitter:Emit(3)
			emitter.Enabled = false
		end
	end

	return object
end

local function play20SeriesVfx(track, token)
	emitVfx("fine...Emit", 3, token)

	local started = os.clock()
	while token == sequence and track.IsPlaying and os.clock() - started < 8 do
		emitVfx("fine...1", 0.3, token)
		emitVfx("fine...1OG", 0.3, token)
		task.wait(0.1)
	end

	if token ~= sequence or not track.IsPlaying then return end

	emitVfx("fine...Emit2OG", 5, token)
	emitVfx(FINAL_VFX_NAME, 5, token)
end

----------------------------------------------------------------
-- VFX que siguen al HumanoidRootPart (Swift Sweep)
----------------------------------------------------------------

local SWEEP_VFX_OFFSET_DOWN = 2      -- studs por debajo del HumanoidRootPart
local SWEEP_ROTATE_START = 90         -- grados en Y al aparecer (a la derecha del jugador)
local SWEEP_ROTATE_END = -90          -- grados en Y tras el volteo (a la izquierda del jugador)
local SWEEP_FLIP_TIME = 0.2          -- el volteo termina justo antes de que el decal se desvanezca
local PARTICLE_SPINNER_DURATION = 5
local SWEEP_DECAL_ROTATE_OFFSET = 180     -- giro extra del decal (SweepCresc) para que aparezca enfrente y no detrás del jugador

-- Ángulo actual en Y (grados) según el tiempo transcurrido desde que aparecieron los VFX
local function getSweepAngle(state, reversed)
	local alpha = math.clamp((os.clock() - state.startTime) / SWEEP_FLIP_TIME, 0, 1)
	local startAngle = reversed and SWEEP_ROTATE_END or SWEEP_ROTATE_START
	local endAngle = reversed and SWEEP_ROTATE_START or SWEEP_ROTATE_END
	local offset = reversed and SWEEP_DECAL_ROTATE_OFFSET or 0
	return startAngle + (endAngle - startAngle) * alpha + offset
end

local function attachVfxToRoot(name, token, state, reversed)
	if token ~= sequence then return nil end

	local kjEffects = getKJEffects()
	local template = kjEffects and kjEffects:FindFirstChild(name)
	if not template then return nil end

	local character = player.Character
	local root = character and character:FindFirstChild("HumanoidRootPart")
	if not root then return nil end

	local object = template:Clone()

	-- Evitar bucles: sin emisión continua ni sonidos en loop
	for _, descendant in ipairs(object:GetDescendants()) do
		if descendant:IsA("ParticleEmitter") then
			descendant.Enabled = false
		elseif descendant:IsA("Sound") then
			descendant.Looped = false
		end
	end

	-- "top" es lo que se mueve y se destruye (el propio VFX o una pieza contenedora)
	local top = object
	local setCFrame

	if object:IsA("BasePart") then
		object.Anchored = true
		object.CanCollide = false
		setCFrame = function(cf) object.CFrame = cf end
	elseif object:IsA("Model") then
		for _, part in ipairs(object:GetDescendants()) do
			if part:IsA("BasePart") then
				part.Anchored = true
				part.CanCollide = false
			end
		end
		setCFrame = function(cf) object:PivotTo(cf) end
	else
		-- Attachment u otro tipo: se mete dentro de una pieza invisible
		local holder = Instance.new("Part")
		holder.Name = name .. "_Holder"
		holder.Size = Vector3.one * 0.1
		holder.Transparency = 1
		holder.Anchored = true
		holder.CanCollide = false
		holder.CanQuery = false
		holder.CanTouch = false
		object.Parent = holder
		top = holder
		setCFrame = function(cf) holder.CFrame = cf end
	end

	local function update()
		local cf = CFrame.new(root.Position - Vector3.new(0, SWEEP_VFX_OFFSET_DOWN, 0))
			* root.CFrame.Rotation
			* CFrame.Angles(0, math.rad(getSweepAngle(state, reversed)), 0)
		setCFrame(cf)
	end

	update()
	top.Parent = workspace
	table.insert(currentVfx, top)

	-- Sigue al HumanoidRootPart (a 5 studs abajo) mientras exista
	local conn
	conn = RunService.RenderStepped:Connect(function()
		if not top.Parent or not root.Parent or token ~= sequence then
			conn:Disconnect()
			return
		end
		update()
	end)

	return top
end

local function playSweepCresc(token, state)
	-- SweepCresc gira en sentido inverso para que el barrido no se vea en reversa
	local object = attachVfxToRoot("SweepCresc", token, state, true)
	if not object then return end

	local decal = object:FindFirstChildWhichIsA("Decal", true)
	if not decal then
		-- Si no hay decal, se elimina igual tras 0.25 s
		task.delay(0.25, function()
			if object and object.Parent then object:Destroy() end
		end)
		return
	end

	-- Aparece visible de golpe (0.7) y luego vuelve a 1 con un tween
	decal.Transparency = 0.7
	task.wait(0.2)

	if token ~= sequence or not decal.Parent then
		if object and object.Parent then object:Destroy() end
		return
	end

	local tween = TweenService:Create(
		decal,
		TweenInfo.new(0.1, Enum.EasingStyle.Linear),
		{ Transparency = 1 }
	)
	tween:Play()
	tween.Completed:Wait()

	if object and object.Parent then
		object:Destroy()
	end
end

-- Emite UNA sola vez (sin bucle). Si el emisor tiene el atributo "EmitCount" lo usa.
local function emitOnce(object)
	for _, emitter in ipairs(object:GetDescendants()) do
		if emitter:IsA("ParticleEmitter") then
			emitter.Enabled = false
			emitter:Emit(emitter:GetAttribute("EmitCount") or 1)
		end
	end
end

local function playParticleSpinner(token, state)
	local object = attachVfxToRoot("particlespinner", token, state)
	if not object then return end

	emitOnce(object)

	-- Sigue al HumanoidRootPart y se elimina a los 5 s
	Debris:AddItem(object, PARTICLE_SPINNER_DURATION)
end

