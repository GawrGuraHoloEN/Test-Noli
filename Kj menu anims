-- Wall Combo frame display (kept compatible with the original menu).
local function showWallCombo(token)
	task.delay(2.9,function()
		if token~=sequence then return end
		local walls = getKJEffects() and getKJEffects():FindFirstChild("Walls")
		if not walls then warn("ReplicatedStorage.Resources.KJEffects.Walls was not found."); return end
		local screen = Instance.new("ScreenGui"); screen.Name="WallComboSequence"; screen.IgnoreGuiInset=true; screen.DisplayOrder=100; screen.Parent=playerGui
		local bg=Instance.new("Frame"); bg.Size=UDim2.fromScale(1,1); bg.BackgroundColor3=Color3.new(0,0,0); bg.ZIndex=1; bg.Parent=screen
		local frames={}; local source=walls:FindFirstChild("Frames",true)
		if source then for _,v in ipairs(source:GetChildren()) do if v:IsA("ImageLabel") or v:IsA("ImageButton") then table.insert(frames,{n=tonumber(string.match(v.Name,"%d+")) or math.huge,name=v.Name,image=v.Image}) end end end
		if #frames==0 then for _,v in ipairs(walls:GetDescendants()) do if v:IsA("Decal") then table.insert(frames,{n=tonumber(string.match(v.Name,"%d+")) or math.huge,name=v.Name,image=v.Texture}) end end end
		table.sort(frames,function(a,b) return a.n==b.n and a.name<b.name or a.n<b.n end)
		local images={}; for i,v in ipairs(frames) do local im=Instance.new("ImageLabel"); im.Size=UDim2.fromScale(1,1); im.BackgroundTransparency=1; im.Image=v.image; im.ImageTransparency=1; im.ZIndex=2; im.Parent=screen; table.insert(images,im) end
		pcall(function() ContentProvider:PreloadAsync(images) end)
		for _,im in ipairs(images) do if token~=sequence then screen:Destroy(); return end; im.ImageTransparency=0; task.wait(.014); im.ImageTransparency=1; task.wait(.014) end
		if screen.Parent then screen:Destroy() end
	end)
end
addMove("Wall Combo", function(t) playAnimation(WALL_COMBO_ANIMATION_ID); playSound("18443048724",0,t); playSound("18443049348",0,t); playSound("18443813318",5.9,t); showWallCombo(t) end)

