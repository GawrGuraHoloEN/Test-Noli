-- LocalScript: place in StarterPlayer > StarterPlayerScripts
-- Full animation/sound menu + spawn lock + respawn-safe replacement detection

local Players = game:GetService("Players")
local UserInputService = game:GetService("UserInputService")
local RunService = game:GetService("RunService")

local player = Players.LocalPlayer

local currentTracks = {}
local currentSounds = {}
local sequence = 0

local spawnTrack = nil
local spawnSound = nil
local spawnActive = false
local spawnAnimationConnection = nil
local spawnHeartbeatConnection = nil
local movementConnection = nil
local animationReplacementConnection = nil

local SPAWN_ANIMATION_ID = "17325160621"
local SPAWN_SOUND_ID = "17325174223"

local REPLACEMENTS = {
	[10469493270] = 17325510002,
	[10469630950] = 17325513870,
	[10469639222] = 17325522388,
	[10469643643] = 17325537719,
}

local function disconnect(connection)
	if connection then
		connection:Disconnect()
	end
	return nil
end

local function getCharacter()
	local character = player.Character or player.CharacterAdded:Wait()

	local humanoid = character:FindFirstChildOfClass("Humanoid")
		or character:WaitForChild("Humanoid")

	local animator = humanoid:FindFirstChildOfClass("Animator")

	if not animator then
		animator = Instance.new("Animator")
		animator.Parent = humanoid
	end

	return character, humanoid, animator
end

local function getTorso(character)
	return character:FindFirstChild("Torso")
		or character:FindFirstChild("UpperTorso")
		or character:FindFirstChild("HumanoidRootPart")
		or character
end

local function stopTrack(track)
	if track and track.IsPlaying then
		track:Stop(0.15)
	end
end

local function stopSound(sound)
	if sound then
		sound:Stop()
		sound:Destroy()
	end
end

local function stopCurrent(force)
	if spawnActive and not force then
		return false
	end

	sequence += 1

	spawnAnimationConnection = disconnect(spawnAnimationConnection)
	spawnHeartbeatConnection = disconnect(spawnHeartbeatConnection)
	movementConnection = disconnect(movementConnection)
	animationReplacementConnection = disconnect(animationReplacementConnection)

	spawnActive = false
	spawnTrack = nil
	spawnSound = nil

	for _, track in ipairs(currentTracks) do
		stopTrack(track)
	end
	table.clear(currentTracks)

	for _, sound in ipairs(currentSounds) do
		stopSound(sound)
	end
	table.clear(currentSounds)

	return true
end

local function playAnimation(id, priority)
	local _, _, animator = getCharacter()

	local animation = Instance.new("Animation")
	animation.AnimationId = "rbxassetid://" .. id

	local track = animator:LoadAnimation(animation)
	animation:Destroy()

	track.Priority = priority or Enum.AnimationPriority.Action
	track:Play(0.15)

	table.insert(currentTracks, track)
	return track
end

local function playSound(id, delayTime, token)
	task.delay(delayTime or 0, function()
		if token ~= sequence or spawnActive then
			return
		end

		local character = getCharacter()
		local torso = getTorso(character)

		local sound = Instance.new("Sound")
		sound.SoundId = "rbxassetid://" .. id
		sound.Volume = 1
		sound.Parent = torso

		table.insert(currentSounds, sound)

		sound.Ended:Connect(function()
			if sound and sound.Parent then
				sound:Destroy()
			end
		end)

		sound:Play()
	end)
end

local function setupAnimationReplacement(character)
	if animationReplacementConnection then
		animationReplacementConnection:Disconnect()
		animationReplacementConnection = nil
	end

	if not character or character ~= player.Character then
		return
	end

	local humanoid = character:FindFirstChildOfClass("Humanoid")
		or character:WaitForChild("Humanoid")

	local animator = humanoid:FindFirstChildOfClass("Animator")

	if not animator then
		animator = Instance.new("Animator")
		animator.Parent = humanoid
	end

	animationReplacementConnection = animator.AnimationPlayed:Connect(function(animationTrack)
		if not animationTrack or not animationTrack.Animation then
			return
		end

		local animationId = tonumber(string.match(animationTrack.Animation.AnimationId, "%d+"))
		local replacementId = REPLACEMENTS[animationId]

		if not replacementId then
			return
		end

		animationTrack:Stop(0)

		if character ~= player.Character then
			return
		end

		local replacementAnimation = Instance.new("Animation")
		replacementAnimation.AnimationId = "rbxassetid://" .. tostring(replacementId)

		local replacementTrack = animator:LoadAnimation(replacementAnimation)
		replacementAnimation:Destroy()

		replacementTrack.Priority = Enum.AnimationPriority.Action4
		replacementTrack:Play(0.1)
	end)
end

local function playSpawnAnimation(character)
	if not character or character ~= player.Character then
		return
	end

	local humanoid = character:FindFirstChildOfClass("Humanoid")
		or character:WaitForChild("Humanoid")

	local animator = humanoid:FindFirstChildOfClass("Animator")

	if not animator then
		animator = Instance.new("Animator")
		animator.Parent = humanoid
	end

	stopCurrent(true)

	spawnActive = true
	local spawnToken = sequence

	spawnAnimationConnection = animator.AnimationPlayed:Connect(function(track)
		if spawnActive and track ~= spawnTrack and track.IsPlaying then
			track:Stop(0.15)
		end
	end)

	spawnHeartbeatConnection = RunService.Heartbeat:Connect(function()
		if not spawnActive or spawnToken ~= sequence then
			return
		end

		if not character or character ~= player.Character then
			stopCurrent(true)
			return
		end

		for _, track in ipairs(animator:GetPlayingAnimationTracks()) do
			if track ~= spawnTrack then
				stopTrack(track)
			end
		end
	end)

	task.wait(0.3)

	if character ~= player.Character or spawnToken ~= sequence then
		stopCurrent(true)
		return
	end

	for _, track in ipairs(animator:GetPlayingAnimationTracks()) do
		stopTrack(track)
	end

	local animation = Instance.new("Animation")
	animation.AnimationId = "rbxassetid://" .. SPAWN_ANIMATION_ID

	local track = animator:LoadAnimation(animation)
	animation:Destroy()

	track.Priority = Enum.AnimationPriority.Action4
	spawnTrack = track
	track:Play(0.15)
	table.insert(currentTracks, track)

	local sound = Instance.new("Sound")
	sound.SoundId = "rbxassetid://" .. SPAWN_SOUND_ID
	sound.Volume = 1
	sound.Parent = getTorso(character)
	spawnSound = sound
	sound:Play()
	table.insert(currentSounds, sound)

	sound.Ended:Connect(function()
		if sound and sound.Parent then
			sound:Destroy()
		end

		if spawnSound == sound then
			spawnSound = nil
		end
	end)

	movementConnection = humanoid.Running:Connect(function(speed)
		if spawnActive and speed > 0.1 and spawnToken == sequence then
			stopCurrent(true)
		end
	end)

	track.Stopped:Connect(function()
		if spawnTrack ~= track then
			return
		end

		spawnActive = false
		spawnTrack = nil
		spawnSound = nil

		spawnAnimationConnection = disconnect(spawnAnimationConnection)
		spawnHeartbeatConnection = disconnect(spawnHeartbeatConnection)
		movementConnection = disconnect(movementConnection)
	end)
end

