-- Limpieza
----------------------------------------------------------------

local function clearVfx()
	for _, object in ipairs(currentVfx) do
		if object and object.Parent then
			object:Destroy()
		end
	end
	table.clear(currentVfx)
end

local function hideWallComboFrames()
	if not preloadedWallComboGui then
		return
	end

	for _, image in ipairs(preloadedWallComboImages) do
		if image and image.Parent then
			image.Visible = false
			image.ImageTransparency = 1
		end
	end

	if preloadedWallComboBackground then
		preloadedWallComboBackground.Visible = false
		preloadedWallComboBackground.BackgroundTransparency = 1
	end

	preloadedWallComboGui.Enabled = false
end

local function removeOldWallComboGui()
	hideWallComboFrames()
end

local function stopUltMusic()
	if ultSound then
		ultSound:Stop()
		ultSound:Destroy()
		ultSound = nil
	end
end

----------------------------------------------------------------
-- Cutscene de cámara (Wall Combo)
----------------------------------------------------------------

local CUTSCENE_NAME = "KJ"
local CUTSCENE_SPEED = 60
local CUTSCENE_BIND_NAME = "WallComboCutscene"

local cutsceneBound = false
local cutsceneState = nil
local cutsceneData = nil

local function getCutsceneData()
	if cutsceneData then
		return cutsceneData
	end

	local folder = ReplicatedStorage:FindFirstChild("Cutscenes")
	local moduleScript = folder and folder:FindFirstChild(CUTSCENE_NAME)
	if not moduleScript then
		return nil
	end

	local success, result = pcall(require, moduleScript)
	if success then
		cutsceneData = result
	end

	return cutsceneData
end

local function stopCutscene()
	if cutsceneBound then
		cutsceneBound = false
		pcall(function()
			RunService:UnbindFromRenderStep(CUTSCENE_BIND_NAME)
		end)
	end

	if not cutsceneState then
		return
	end

	local state = cutsceneState
	cutsceneState = nil

	local camera = workspace.CurrentCamera
	if camera then
		camera.FieldOfView = state.fov
		camera.CameraType = Enum.CameraType.Custom
		camera.CFrame = state.cframe
	end

	-- Restaurar shiftlock / primera persona
	pcall(function()
		player.DevEnableMouseLock = state.mouseLockEnabled
		player.CameraMode = state.cameraMode
	end)
	UserInputService.MouseBehavior = state.mouseBehavior

	local character = player.Character
	local humanoid = character and character:FindFirstChildOfClass("Humanoid")
	if humanoid then
		humanoid.AutoRotate = state.autoRotate
		humanoid.CameraOffset = state.cameraOffset
	end
end

local function playCutscene(data, token)
	if not data then return end

	stopCutscene()

	local camera = workspace.CurrentCamera
	local _, humanoid = getCharacter()
	if not camera or not humanoid then return end

	cutsceneState = {
		cframe = camera.CFrame,
		fov = camera.FieldOfView,
		autoRotate = humanoid.AutoRotate,
		cameraOffset = humanoid.CameraOffset,
		mouseBehavior = UserInputService.MouseBehavior,
		mouseLockEnabled = player.DevEnableMouseLock,
		cameraMode = player.CameraMode,
	}

	local elapsed = 0

	humanoid.AutoRotate = false
	camera.CameraType = Enum.CameraType.Scriptable

	-- Bloquear shiftlock y primera persona mientras dura la cutscene
	pcall(function()
		player.DevEnableMouseLock = false
		player.CameraMode = Enum.CameraMode.Classic
	end)
	humanoid.CameraOffset = Vector3.zero
	UserInputService.MouseBehavior = Enum.MouseBehavior.Default

	cutsceneBound = true

	-- Se ejecuta justo DESPUÉS del script de cámara de Roblox, así nada puede sobreescribirla
	RunService:BindToRenderStep(CUTSCENE_BIND_NAME, Enum.RenderPriority.Camera.Value + 1, function(dt)
		local character = player.Character
		local root = character and character:FindFirstChild("HumanoidRootPart")

		-- Si se interrumpe el movimiento o no hay personaje, se cancela y se restaura la cámara
		if token ~= sequence or not root then
			stopCutscene()
			return
		end

		-- Mantener bloqueado lo que shiftlock / primera persona intenten cambiar
		if UserInputService.MouseBehavior ~= Enum.MouseBehavior.Default then
			UserInputService.MouseBehavior = Enum.MouseBehavior.Default
		end
		if humanoid.AutoRotate then
			humanoid.AutoRotate = false
		end
		if humanoid.CameraOffset ~= Vector3.zero then
			humanoid.CameraOffset = Vector3.zero
		end
		if camera.CameraType ~= Enum.CameraType.Scriptable then
			camera.CameraType = Enum.CameraType.Scriptable
		end

		elapsed = elapsed + dt * CUTSCENE_SPEED
		local frame = data[math.ceil(elapsed)]

		if frame then
			TweenService:Create(camera, TweenInfo.new(0.0005, Enum.EasingStyle.Quad, Enum.EasingDirection.InOut), {
				CFrame = root.CFrame * frame.cframe,
				FieldOfView = frame.fov,
			}):Play()
		else
			-- Terminó la cutscene
			stopCutscene()
		end
	end)
end

function stopCurrent()
	sequence += 1
	stopForcedMovement()

	for _, track in ipairs(currentTracks) do
		if track then track:Stop(0.15) end
	end
	table.clear(currentTracks)

	local character = player.Character
	local humanoid = character and character:FindFirstChildOfClass("Humanoid")
	local animator = humanoid and humanoid:FindFirstChildOfClass("Animator")

	if animator then
		for _, track in ipairs(animator:GetPlayingAnimationTracks()) do
			track:Stop(0.15)
		end
	end

	for _, sound in ipairs(currentSounds) do
		if sound then
			sound:Stop()
			sound:Destroy()
		end
	end
	table.clear(currentSounds)

	clearVfx()
	removeOldWallComboGui()
	stopCutscene()

	-- Si el movimiento se interrumpe, el clon del Wall Combo también se elimina
	if wallComboCloneHandle then
		wallComboCloneHandle.destroy()
		wallComboCloneHandle = nil
	end

	-- También el cráter y las partes del impacto
	if wallComboImpactFolder then
		wallComboImpactFolder:Destroy()
		wallComboImpactFolder = nil
	end
end

