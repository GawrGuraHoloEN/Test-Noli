----------------------------------------------------------------
-- Personaje
----------------------------------------------------------------

local function getCharacter()
	local character = player.Character or player.CharacterAdded:Wait()

	local humanoid = character:FindFirstChildOfClass("Humanoid")
		or character:WaitForChild("Humanoid")

	local animator = humanoid:FindFirstChildOfClass("Animator")

	if not animator then
		animator = Instance.new("Animator")
		animator.Parent = humanoid
	end

	return character, humanoid, animator
end

local function getRoot(character)
	return character:FindFirstChild("HumanoidRootPart")
		or character:WaitForChild("HumanoidRootPart")
end

local function getSoundParent(character)
	return character:FindFirstChild("Torso")
		or character:FindFirstChild("UpperTorso")
		or getRoot(character)
end

local function getKJEffects()
	local resources = ReplicatedStorage:FindFirstChild("Resources")
	if not resources then
		return nil
	end

	return resources:FindFirstChild("KJEffects")
end

----------------------------------------------------------------
-- Control del jugador (20 Series Alt y 20-20-20 Dropkick)
----------------------------------------------------------------

local function getPlayerControls()
	if playerControls then
		return playerControls
	end

	local playerScripts = player:FindFirstChild("PlayerScripts")
	if not playerScripts then
		return nil
	end

	local playerModule = playerScripts:FindFirstChild("PlayerModule")
	if not playerModule then
		return nil
	end

	local success, module = pcall(require, playerModule)

	if success and module then
		playerControls = module:GetControls()
		return playerControls
	end

	return nil
end

local function stopForcedMovement()
	forcedMovementToken += 1

	if forcedMovementConnection then
		forcedMovementConnection:Disconnect()
		forcedMovementConnection = nil
	end

	local character = player.Character
	local humanoid = character and character:FindFirstChildOfClass("Humanoid")

	if humanoid then
		if savedWalkSpeed ~= nil then
			humanoid.WalkSpeed = savedWalkSpeed
		end

		if savedAutoRotate ~= nil then
			humanoid.AutoRotate = savedAutoRotate
		end
	end

	savedWalkSpeed = nil
	savedAutoRotate = nil

	local controls = getPlayerControls()
	if controls then
		controls:Enable()
	end
end

local function force20SeriesAltMovement(track, token)
	stopForcedMovement()

	local character, humanoid, animator = getCharacter()
	local root = getRoot(character)

	savedWalkSpeed = humanoid.WalkSpeed
	savedAutoRotate = humanoid.AutoRotate

	local controls = getPlayerControls()
	if controls then
		controls:Disable()
	end

	humanoid.WalkSpeed = 5
	humanoid.AutoRotate = false

	forcedMovementToken += 1
	local movementToken = forcedMovementToken
	local startTime = os.clock()

	forcedMovementConnection = RunService.RenderStepped:Connect(function()
		local elapsed = os.clock() - startTime

		if token ~= sequence
			or movementToken ~= forcedMovementToken
			or elapsed >= 1.8
			or not character.Parent
			or not humanoid.Parent
			or not root.Parent
			or not track.IsPlaying then

			stopForcedMovement()
			return
		end

		if humanoid.WalkSpeed ~= 5 then
			humanoid.WalkSpeed = 5
		end

		humanoid.AutoRotate = false

		for _, otherTrack in ipairs(animator:GetPlayingAnimationTracks()) do
			if otherTrack ~= track then
				otherTrack:Stop(0)
			end
		end

		humanoid:Move(root.CFrame.LookVector, false)
	end)
end

local function forceDropkickMovement(track, token)
	stopForcedMovement()

	local character, humanoid, animator = getCharacter()
	local root = getRoot(character)

	savedWalkSpeed = humanoid.WalkSpeed
	savedAutoRotate = humanoid.AutoRotate

	local controls = getPlayerControls()
	if controls then
		controls:Disable()
	end

	forcedMovementToken += 1
	local movementToken = forcedMovementToken
	local startTime = os.clock()
	
	local hasStartedDash = false
	local lastSpeedlineTime = 0
	local activeVfx = {} 
	
	local thingVfxInstance = nil 
	local hasDisabledThing = false

	local trackStoppedConn = nil
	trackStoppedConn = track.Stopped:Connect(function()
		if trackStoppedConn then
			trackStoppedConn:Disconnect()
			trackStoppedConn = nil
		end

		local isNaturalEnd = (track.Length > 0) and (track.TimePosition >= track.Length - 0.15)
		if not isNaturalEnd and token == sequence and movementToken == forcedMovementToken then
			local currentStop = stopCurrent
			if currentStop then
				currentStop()
			end
		end
	end)

	forcedMovementConnection = RunService.RenderStepped:Connect(function()
		local elapsed = os.clock() - startTime

		if token ~= sequence
			or movementToken ~= forcedMovementToken
			or elapsed >= 6
			or not character.Parent
			or not humanoid.Parent
			or not root.Parent
			or not track.IsPlaying then

			if trackStoppedConn then
				trackStoppedConn:Disconnect()
				trackStoppedConn = nil
			end

			for _, vfx in ipairs(activeVfx) do
				if vfx and vfx.Parent then
					vfx:Destroy()
				end
			end

			stopForcedMovement()
			return
		end

		for _, otherTrack in ipairs(animator:GetPlayingAnimationTracks()) do
			if otherTrack ~= track then
				otherTrack:Stop(0)
				otherTrack:AdjustWeight(0)
			end
		end

		if elapsed < 2 then
			humanoid.WalkSpeed = 0
			humanoid.AutoRotate = true 
		else
			if not hasStartedDash then
				hasStartedDash = true
				
				local kjEffects = getKJEffects()
				if kjEffects then
					local fxStuff = kjEffects:FindFirstChild("speedlinesandstuff")
					local fxThing = fxStuff and fxStuff:FindFirstChild("thespeedthingunderultik")

					local function spawnPersistentVfx(template)
						if not template then return nil end
						local clone = template:Clone()
						
						if clone:IsA("Attachment") then
							clone.Parent = root
							clone.Position = Vector3.zero
						elseif clone:IsA("BasePart") then
							clone.CFrame = root.CFrame
							clone.Parent = workspace
						else
							clone.Parent = root
						end
						
						for _, em in ipairs(clone:GetDescendants()) do
							if em:IsA("ParticleEmitter") then
								em.Enabled = true
							end
						end
						
						table.insert(currentVfx, clone)
						table.insert(activeVfx, clone)
						return clone
					end

					spawnPersistentVfx(fxStuff)
					thingVfxInstance = spawnPersistentVfx(fxThing)
				end
			end

			if elapsed >= 4 and not hasDisabledThing then
				hasDisabledThing = true
				if thingVfxInstance and thingVfxInstance.Parent then
					for _, emitter in ipairs(thingVfxInstance:GetDescendants()) do
						if emitter:IsA("ParticleEmitter") then
							emitter.Enabled = false
						end
					end
				end
			end

			humanoid.WalkSpeed = 250
			humanoid.AutoRotate = true 
			humanoid:Move(root.CFrame.LookVector, false)

			for _, vfx in ipairs(activeVfx) do
				if vfx and vfx.Parent and vfx:IsA("BasePart") then
					vfx.CFrame = root.CFrame
				end
			end

			if os.clock() - lastSpeedlineTime >= 0.1 then
				lastSpeedlineTime = os.clock()
				
				local kjEffects = getKJEffects()
				local fxSpeedlines = kjEffects and kjEffects:FindFirstChild("speedlines")
				
				if fxSpeedlines then
					local slClone = fxSpeedlines:Clone()
					if slClone:IsA("Attachment") then
						slClone.Parent = root
						slClone.Position = Vector3.zero
					elseif slClone:IsA("BasePart") then
						slClone.CFrame = root.CFrame
						slClone.Parent = workspace
					else
						slClone.Parent = root
					end
					
					table.insert(currentVfx, slClone)
					Debris:AddItem(slClone, 1)
					
					for _, emitter in ipairs(slClone:GetDescendants()) do
						if emitter:IsA("ParticleEmitter") then
							emitter.Enabled = true
							emitter:Emit(3)
							emitter.Enabled = false
						end
					end
				end
			end
		end
	end)
end

----------------------------------------------------------------
-- Limpieza
----------------------------------------------------------------

local function clearVfx()
	for _, object in ipairs(currentVfx) do
		if object and object.Parent then
			object:Destroy()
		end
	end
	table.clear(currentVfx)
end

local function hideWallComboFrames()
	if not preloadedWallComboGui then
		return
	end

	for _, image in ipairs(preloadedWallComboImages) do
		if image and image.Parent then
			image.Visible = false
			image.ImageTransparency = 1
		end
	end

	if preloadedWallComboBackground then
		preloadedWallComboBackground.Visible = false
		preloadedWallComboBackground.BackgroundTransparency = 1
	end

	preloadedWallComboGui.Enabled = false
end

local function removeOldWallComboGui()
	hideWallComboFrames()
end

local function stopUltMusic()
	if ultSound then
		ultSound:Stop()
		ultSound:Destroy()
		ultSound = nil
	end
end

function stopCurrent()
	sequence += 1
	stopForcedMovement()

	for _, track in ipairs(currentTracks) do
		if track then track:Stop(0.15) end
	end
	table.clear(currentTracks)

	local character = player.Character
	local humanoid = character and character:FindFirstChildOfClass("Humanoid")
	local animator = humanoid and humanoid:FindFirstChildOfClass("Animator")

	if animator then
		for _, track in ipairs(animator:GetPlayingAnimationTracks()) do
			track:Stop(0.15)
		end
	end

	for _, sound in ipairs(currentSounds) do
		if sound then
			sound:Stop()
			sound:Destroy()
		end
	end
	table.clear(currentSounds)

	clearVfx()
	removeOldWallComboGui()
end

----------------------------------------------------------------
-- Ult Music
----------------------------------------------------------------

local function startUltMusic(token)
	if token and token ~= sequence then return end
	if not ultMusicEnabled or ultSound then return end
	local character = player.Character
	if not character then return end

	local sound = Instance.new("Sound")
	sound.Name = "UltMusic"
	sound.SoundId = "rbxassetid://" .. ULT_MUSIC_ID
	sound.Volume = 1
	sound.Looped = true
	sound.Parent = getSoundParent(character)

	ultSound = sound
	sound:Play()
end

local function startUltMusicAfter(delayTime, token)
	task.delay(delayTime, function()
		if token ~= sequence then return end
		if not ultMusicEnabled then return end
		startUltMusic(token)
	end)
end

----------------------------------------------------------------
-- Animaciones
----------------------------------------------------------------

local function playAnimation(id)
	local _, _, animator = getCharacter()
	local animation = Instance.new("Animation")
	animation.AnimationId = "rbxassetid://" .. tostring(id)

	local track = animator:LoadAnimation(animation)
	animation:Destroy()

	track.Priority = Enum.AnimationPriority.Action
	track:Play(0.15)
	table.insert(currentTracks, track)
	return track
end

----------------------------------------------------------------
-- Sonidos
----------------------------------------------------------------

local function createSound(id, token)
	if token ~= sequence then return nil end
	local character = player.Character
	if not character then return nil end

	local sound = Instance.new("Sound")
	sound.SoundId = "rbxassetid://" .. tostring(id)
	sound.Volume = 1
	sound.Parent = getSoundParent(character)

	table.insert(currentSounds, sound)

	sound.Ended:Connect(function()
		if sound and sound.Parent then
			sound:Destroy()
		end
	end)

	sound:Play()
	return sound
end

local function playSound(id, delayTime, token)
	task.delay(delayTime or 0, function()
		if token ~= sequence then return end
		createSound(id, token)
	end)
end

----------------------------------------------------------------
-- VFX
----------------------------------------------------------------

local function emitVfx(name, lifetime, token)
	if token ~= sequence then return nil end

	local kjEffects = getKJEffects()
	local template = kjEffects and kjEffects:FindFirstChild(name)

	if not template then return nil end

	local character = player.Character or player.CharacterAdded:Wait()
	local root = getRoot(character)
	local object = template:Clone()

	if object:IsA("Attachment") then
		object.Parent = root
		object.Position = Vector3.zero
	elseif object:IsA("BasePart") then
		object.CFrame = root.CFrame
		object.Parent = workspace
	else
		object.Parent = root
	end

	table.insert(currentVfx, object)
	Debris:AddItem(object, lifetime)

	for _, emitter in ipairs(object:GetDescendants()) do
		if emitter:IsA("ParticleEmitter") then
			emitter.Enabled = true
			emitter:Emit(3)
			emitter.Enabled = false
		end
	end

	return object
end

local function play20SeriesVfx(track, token)
	emitVfx("fine...Emit", 3, token)

	local started = os.clock()
	while token == sequence and track.IsPlaying and os.clock() - started < 8 do
		emitVfx("fine...1", 0.3, token)
		emitVfx("fine...1OG", 0.3, token)
		task.wait(0.1)
	end

	if token ~= sequence or not track.IsPlaying then return end

	emitVfx("fine...Emit2OG", 5, token)
	emitVfx(FINAL_VFX_NAME, 5, token)
end

----------------------------------------------------------------
-- Wall Combo
----------------------------------------------------------------

local function getNumberFromName(name)
	return tonumber(string.match(name, "%d+")) or math.huge
end

local function getAssetId(texture)
	if not texture or texture == "" then return nil end
	return string.match(texture, "%d+")
end

local function buildWallComboFrames()
	local kjEffects = getKJEffects()
	local wallsFolder = kjEffects and kjEffects:FindFirstChild("Walls")

	if not wallsFolder then return nil end

	local frames = {}
	local framesFolder = wallsFolder:FindFirstChild("Frames", true)

	if framesFolder then
		for _, object in ipairs(framesFolder:GetChildren()) do
			if object:IsA("ImageLabel") or object:IsA("ImageButton") then
				table.insert(frames, {
					name = object.Name,
					number = getNumberFromName(object.Name),
					image = object.Image,
				})
			end
		end
	end

	if #frames == 0 then
		for _, object in ipairs(wallsFolder:GetDescendants()) do
			if object:IsA("Decal") then
				local assetId = getAssetId(object.Texture)
				if assetId then
					table.insert(frames, {
						name = object.Name,
						number = getNumberFromName(object.Name),
						image = "rbxassetid://" .. assetId,
					})
				end
			end
		end
	end

	table.sort(frames, function(firstFrame, secondFrame)
		if firstFrame.number == secondFrame.number then
			return firstFrame.name < secondFrame.name
		end
		return firstFrame.number < secondFrame.number
	end)

	return frames
end

local function preloadWallComboFrames()
	if preloadedWallComboGui then return end
	local frames = buildWallComboFrames()
	if not frames or #frames == 0 then return end

	local wallGui = Instance.new("ScreenGui")
	wallGui.Name = "WallComboSequence"
	wallGui.IgnoreGuiInset = true
	wallGui.ResetOnSpawn = false
	wallGui.DisplayOrder = 100
	wallGui.ZIndexBehavior = Enum.ZIndexBehavior.Sibling
	wallGui.Enabled = false
	wallGui.Parent = playerGui

	local background = Instance.new("Frame")
	background.Name = "Background"
	background.Size = UDim2.fromScale(1, 1)
	background.Position = UDim2.fromScale(0, 0)
	background.BackgroundColor3 = Color3.new(0, 0, 0)
	background.BackgroundTransparency = 1
	background.BorderSizePixel = 0
	background.Visible = false
	background.ZIndex = 1
	background.Parent = wallGui

	preloadedWallComboGui = wallGui
	preloadedWallComboBackground = background

	for index, frameData in ipairs(frames) do
		local image = Instance.new("ImageLabel")
		image.Name = "WallFrame_" .. tostring(index)
		image.Size = UDim2.fromScale(1, 1)
		image.Position = UDim2.fromScale(0, 0)
		image.BackgroundTransparency = 1
		image.BorderSizePixel = 0
		image.Image = frameData.image
		image.ImageTransparency = 1
		image.ScaleType = Enum.ScaleType.Stretch
		image.Visible = false
		image.ZIndex = 2
		image.Parent = wallGui

		table.insert(preloadedWallComboImages, image)
	end

	pcall(function()
		ContentProvider:PreloadAsync(preloadedWallComboImages)
	end)
end

local function showWallComboDecals(token)
	task.delay(WALL_DECAL_DELAY, function()
		if token ~= sequence then return end
		if not preloadedWallComboGui then preloadWallComboFrames() end
		if not preloadedWallComboGui or #preloadedWallComboImages == 0 then return end

		preloadedWallComboGui.Enabled = true
		if preloadedWallComboBackground then
			preloadedWallComboBackground.Visible = true
			preloadedWallComboBackground.BackgroundTransparency = 0
		end

		for _, image in ipairs(preloadedWallComboImages) do
			if token ~= sequence or not preloadedWallComboGui.Parent then
				hideWallComboFrames()
				return
			end

			for _, otherImage in ipairs(preloadedWallComboImages) do
				otherImage.Visible = false
				otherImage.ImageTransparency = 1
			end

			image.Visible = true
			image.ImageTransparency = 0
			task.wait(WALL_DECAL_DISPLAY_TIME)
			image.ImageTransparency = 1
			image.Visible = false
			task.wait(WALL_DECAL_COOLDOWN)
		end
		hideWallComboFrames()
	end)
end

