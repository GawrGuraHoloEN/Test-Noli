-- LocalScript: place in StarterPlayer > StarterPlayerScripts
local Players = game:GetService("Players")
local UserInputService = game:GetService("UserInputService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Debris = game:GetService("Debris")

local player = Players.LocalPlayer
local playerGui = player:WaitForChild("PlayerGui")
local sequence = 0
local currentTracks = {}
local currentSounds = {}
local currentVfx = {}
local ultMusicEnabled = false
local ultSound

local ULT_MUSIC_ID = "17150550093"
local VFX_FINAL_NAME = "fine...Emit2" -- Cambia este nombre si tu último VFX tiene otro nombre.

local function getCharacter()
	local character = player.Character or player.CharacterAdded:Wait()
	local humanoid = character:FindFirstChildOfClass("Humanoid") or character:WaitForChild("Humanoid")
	local animator = humanoid:FindFirstChildOfClass("Animator")
	if not animator then
		animator = Instance.new("Animator")
		animator.Parent = humanoid
	end
	return character, humanoid, animator
end

local function getRoot(character)
	return character:FindFirstChild("HumanoidRootPart") or character:WaitForChild("HumanoidRootPart")
end

local function getSoundParent(character)
	return character:FindFirstChild("Torso") or character:FindFirstChild("UpperTorso") or getRoot(character)
end

local function getEffectsFolder()
	local resources = ReplicatedStorage:FindFirstChild("Resources")
	return resources and resources:FindFirstChild("KJEffects")
end

local function destroyVfx(object)
	if object and object.Parent then object:Destroy() end
end

local function clearVfx()
	-- Must iterate over the values, not the numeric indexes.
	for _, object in ipairs(currentVfx) do
		destroyVfx(object)
	end
	table.clear(currentVfx)
end

local function stopCurrent()
	sequence += 1

	for _, track in ipairs(currentTracks) do
		if track then track:Stop(0.15) end
	end
	table.clear(currentTracks)

	-- Also stop tracks that might have been started outside this table.
	local _, _, animator = getCharacter()
	for _, track in ipairs(animator:GetPlayingAnimationTracks()) do
		track:Stop(0.15)
	end

	for _, sound in ipairs(currentSounds) do
		if sound then sound:Stop(); sound:Destroy() end
	end
	table.clear(currentSounds)
	clearVfx()

	local wallGui = playerGui:FindFirstChild("WallComboSequence")
	if wallGui then wallGui:Destroy() end
end

local function playAnimation(id)
	local _, _, animator = getCharacter()
	local animation = Instance.new("Animation")
	animation.AnimationId = "rbxassetid://" .. tostring(id)
	local track = animator:LoadAnimation(animation)
	animation:Destroy()
	track.Priority = Enum.AnimationPriority.Action
	track:Play(0.15)
	table.insert(currentTracks, track)
	return track
end

local function playSound(id, delayTime, token)
	task.delay(delayTime or 0, function()
		if token ~= sequence then return end
		local character = player.Character
		if not character then return end
		local sound = Instance.new("Sound")
		sound.SoundId = "rbxassetid://" .. tostring(id)
		sound.Volume = 1
		sound.Parent = getSoundParent(character)
		table.insert(currentSounds, sound)
		sound.Ended:Connect(function()
			if sound.Parent then sound:Destroy() end
		end)
		sound:Play()
	end)
end

local function stopUltMusic()
	if ultSound then
		ultSound:Stop()
		ultSound:Destroy()
		ultSound = nil
	end
end

local function startUltMusic()
	if not ultMusicEnabled or ultSound or not player.Character then return end
	local sound = Instance.new("Sound")
	sound.Name = "UltMusic"
	sound.SoundId = "rbxassetid://" .. ULT_MUSIC_ID
	sound.Volume = 1
	sound.Looped = true
	sound.Parent = getSoundParent(player.Character)
	ultSound = sound
	sound:Play()
end

local function playSoundThenUltMusic(id, token)
	playSound(id, 0, token)
	local sound = currentSounds[#currentSounds]
	if not sound then return end
	sound.Ended:Connect(function()
		if token == sequence and ultMusicEnabled then startUltMusic() end
	end)
end

local function emitVfx(name, lifetime, token)
	if token ~= sequence then return nil end
	local folder = getEffectsFolder()
	local template = folder and folder:FindFirstChild(name)
	if not template then
		warn("VFX no encontrado: ReplicatedStorage.Resources.KJEffects." .. name)
		return nil
	end

	local object = template:Clone()
	local root = getRoot(player.Character or player.CharacterAdded:Wait())
	if object:IsA("Attachment") then
		object.Parent = root
		object.Position = Vector3.zero
	elseif object:IsA("BasePart") then
		object.CFrame = root.CFrame
		object.Parent = workspace
	else
		object.Parent = root
	end

	table.insert(currentVfx, object)
	Debris:AddItem(object, lifetime)
	for _, emitter in ipairs(object:GetDescendants()) do
		if emitter:IsA("ParticleEmitter") then
			emitter.Enabled = true
			emitter:Emit(3)
			emitter.Enabled = false
		end
	end
	return object
end

local function play20SeriesVfx(track, token)
	emitVfx("fine...Emit", 3, token)
	local started = os.clock()
	while token == sequence and track.IsPlaying and os.clock() - started < 8 do
		-- Cada pareja aparece durante 0.3 s y se vuelve a crear cada 0.2 s.
		emitVfx("fine...Emit1", 0.3, token)
		emitVfx("fine...Emit1OG", 0.3, token)
		task.wait(0.2)
	end
	if token ~= sequence or not track.IsPlaying then return end
	emitVfx("fine...Emit2OG", 5, token)
	emitVfx(VFX_FINAL_NAME, 5, token)
end

