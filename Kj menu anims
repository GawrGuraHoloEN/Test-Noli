local function getNumberFromName(name)
	return tonumber(string.match(name, "%d+")) or math.huge
end

local function getAssetId(texture)
	if not texture or texture == "" then return nil end
	return string.match(texture, "%d+")
end

local function buildWallComboFrames()
	local kjEffects = getKJEffects()
	local wallsFolder = kjEffects and kjEffects:FindFirstChild("Walls")

	if not wallsFolder then return nil end

	local frames = {}
	local framesFolder = wallsFolder:FindFirstChild("Frames", true)

	if framesFolder then
		for _, object in ipairs(framesFolder:GetChildren()) do
			if object:IsA("ImageLabel") or object:IsA("ImageButton") then
				table.insert(frames, {
					name = object.Name,
					number = getNumberFromName(object.Name),
					image = object.Image,
				})
			end
		end
	end

	if #frames == 0 then
		for _, object in ipairs(wallsFolder:GetDescendants()) do
			if object:IsA("Decal") then
				local assetId = getAssetId(object.Texture)
				if assetId then
					table.insert(frames, {
						name = object.Name,
						number = getNumberFromName(object.Name),
						image = "rbxassetid://" .. assetId,
					})
				end
			end
		end
	end

	table.sort(frames, function(firstFrame, secondFrame)
		if firstFrame.number == secondFrame.number then
			return firstFrame.name < secondFrame.name
		end
		return firstFrame.number < secondFrame.number
	end)

	return frames
end

-- Copia local de los frames (se guarda aquí para que sigan existiendo aunque el original desaparezca al reiniciar)
local wallComboFramesData = nil

local function preloadWallComboFrames()
	-- Copiar los datos de los frames una sola vez
	if not wallComboFramesData then
		local frames = buildWallComboFrames()
		if frames and #frames > 0 then
			wallComboFramesData = frames
		end
	end

	if not wallComboFramesData then return end

	-- Si la GUI ya existe, no hacer nada
	if preloadedWallComboGui and preloadedWallComboGui.Parent then return end

	-- (Re)crear la GUI a partir de la copia local
	table.clear(preloadedWallComboImages)

	local wallGui = Instance.new("ScreenGui")
	wallGui.Name = "WallComboSequence"
	wallGui.IgnoreGuiInset = true
	wallGui.ResetOnSpawn = false
	wallGui.DisplayOrder = 100
	wallGui.ZIndexBehavior = Enum.ZIndexBehavior.Sibling
	wallGui.Enabled = false
	wallGui.Parent = playerGui

	local background = Instance.new("Frame")
	background.Name = "Background"
	background.Size = UDim2.fromScale(1, 1)
	background.Position = UDim2.fromScale(0, 0)
	background.BackgroundColor3 = Color3.new(0, 0, 0)
	background.BackgroundTransparency = 1
	background.BorderSizePixel = 0
	background.Visible = false
	background.ZIndex = 1
	background.Parent = wallGui

	preloadedWallComboGui = wallGui
	preloadedWallComboBackground = background

	for index, frameData in ipairs(wallComboFramesData) do
		local image = Instance.new("ImageLabel")
		image.Name = "WallFrame_" .. tostring(index)
		image.Size = UDim2.fromScale(1, 1)
		image.Position = UDim2.fromScale(0, 0)
		image.BackgroundTransparency = 1
		image.BorderSizePixel = 0
		image.Image = frameData.image
		image.ImageTransparency = 1
		image.ScaleType = Enum.ScaleType.Stretch
		image.Visible = false
		image.ZIndex = 1 + index -- el frame más nuevo siempre queda encima del anterior
		image.Parent = wallGui

		table.insert(preloadedWallComboImages, image)
	end

	pcall(function()
		ContentProvider:PreloadAsync(preloadedWallComboImages)
	end)

	-- Calentamiento: dibuja cada imagen una vez (1x1 px, casi invisible) para que ya estén
	-- decodificadas y subidas a la GPU. Así no hay tirones la primera vez que se muestran.
	wallComboWarming = true
	task.spawn(function()
		wallGui.Enabled = true

		for _, image in ipairs(preloadedWallComboImages) do
			image.Size = UDim2.fromOffset(1, 1)
			image.ImageTransparency = 0.99
			image.Visible = true
		end

		task.wait(0.3)

		for _, image in ipairs(preloadedWallComboImages) do
			if image.Parent then
				image.Visible = false
				image.ImageTransparency = 1
				image.Size = UDim2.fromScale(1, 1)
			end
		end

		if wallGui.Parent then
			wallGui.Enabled = false
		end

		wallComboWarming = false
	end)
end

local function showWallComboDecals(token)
	task.delay(WALL_DECAL_DELAY, function()
		if token ~= sequence then return end

		if not preloadedWallComboGui or not preloadedWallComboGui.Parent then
			preloadWallComboFrames()
		end
		if not preloadedWallComboGui or #preloadedWallComboImages == 0 then return end

		-- Esperar a que termine el calentamiento de imágenes (máx. 3 s)
		local waited = 0
		while wallComboWarming and waited < 3 do
			waited += task.wait()
		end
		if token ~= sequence or not preloadedWallComboGui.Parent then return end

		local gui = preloadedWallComboGui
		local images = preloadedWallComboImages
		local total = #images
		local frameTime = WALL_DECAL_FRAME_TIME
		local overlap = WALL_DECAL_OVERLAP_TIME

		gui.Enabled = true
		if preloadedWallComboBackground then
			preloadedWallComboBackground.Visible = true
			preloadedWallComboBackground.BackgroundTransparency = 0
		end

		local startTime = os.clock()
		local firstShown = 1 -- frame más antiguo que sigue visible
		local lastShown = 0  -- frame más nuevo mostrado
		local connection = nil
		local finished = false

		local function finish()
			if finished then return end
			finished = true

			if connection then
				connection:Disconnect()
				connection = nil
			end
			hideWallComboFrames()
		end

		-- El frame se calcula por TIEMPO (no con task.wait por frame), así la animación mantiene su
		-- velocidad real: si hay lag se saltan frames en vez de ir más lenta o trabarse.
		-- Cada frame empieza en (k-1)*frameTime y sigue visible hasta k*frameTime + overlap,
		-- mientras el siguiente ya se reproduce encima, así nunca hay huecos vacíos.
		connection = RunService.RenderStepped:Connect(function()
			if token ~= sequence or not gui.Parent then
				finish()
				return
			end

			local elapsed = os.clock() - startTime

			if elapsed >= total * frameTime + overlap then
				finish()
				return
			end

			local newestIndex = math.min(math.floor(elapsed / frameTime) + 1, total)
			local oldestIndex = math.max(math.floor((elapsed - overlap) / frameTime) + 1, 1)

			-- Mostrar los frames nuevos (se salta lo que ya quedó viejo si hubo lag)
			for index = math.max(lastShown + 1, oldestIndex), newestIndex do
				local image = images[index]
				image.Visible = true
				image.ImageTransparency = 0
			end
			lastShown = math.max(lastShown, newestIndex)

			-- Ocultar los que ya cumplieron su tiempo
			if oldestIndex > firstShown then
				for index = firstShown, math.min(oldestIndex - 1, total) do
					local image = images[index]
					image.Visible = false
					image.ImageTransparency = 1
				end
				firstShown = oldestIndex
			end
		end)
	end)
end

----------------------------------------------------------------
-- Clon de otro jugador (Wall Combo)
----------------------------------------------------------------

local WALL_COMBO_CLONE_ANIMATION_ID = "18447915110"
local WALL_COMBO_CLONE_DISTANCE = 0.5      -- studs delante del usuario
local WALL_COMBO_CLONE_LIFETIME = 10       -- segundos antes de eliminarse
local WALL_COMBO_CLONE_MAX_RANGE = 2000    -- rango máximo para buscar al jugador cercano

local function getNearestOtherPlayerCharacter(myRoot)
	local nearestCharacter = nil
	local nearestDistance = WALL_COMBO_CLONE_MAX_RANGE

	for _, otherPlayer in ipairs(Players:GetPlayers()) do
		if otherPlayer ~= player then
			local otherCharacter = otherPlayer.Character
			local otherRoot = otherCharacter and otherCharacter:FindFirstChild("HumanoidRootPart")
			local otherHumanoid = otherCharacter and otherCharacter:FindFirstChildOfClass("Humanoid")

			if otherRoot and otherHumanoid and otherHumanoid.Health > 0 then
				local distance = (otherRoot.Position - myRoot.Position).Magnitude
				if distance < nearestDistance then
					nearestDistance = distance
					nearestCharacter = otherCharacter
				end
			end
		end
	end

	return nearestCharacter
end

-- Devuelve un "handle": handle.instance siempre apunta al clon actual (por si hay que recrearlo)
local function spawnWallComboClone(token)
	if token ~= sequence then return nil end

	local character = player.Character
	local myRoot = character and character:FindFirstChild("HumanoidRootPart")
	if not myRoot then return nil end

	local targetCharacter = getNearestOtherPlayerCharacter(myRoot)
	if not targetCharacter then return nil end

	-- Plantilla (nunca se pone en el workspace): sirve para recrear el clon si algo lo elimina antes de tiempo
	local wasArchivable = targetCharacter.Archivable
	targetCharacter.Archivable = true
	local template = targetCharacter:Clone()
	targetCharacter.Archivable = wasArchivable

	if not template then return nil end

	template.Name = "WallComboClone"

	-- Quitar scripts para que no interfieran (Animate, etc.)
	for _, descendant in ipairs(template:GetDescendants()) do
		if descendant:IsA("Script") or descendant:IsA("LocalScript") then
			descendant:Destroy()
		end
	end

	local templateRoot = template:FindFirstChild("HumanoidRootPart")
	local templateHumanoid = template:FindFirstChildOfClass("Humanoid")
	if not templateRoot or not templateHumanoid then
		template:Destroy()
		return nil
	end

	templateHumanoid.DisplayDistanceType = Enum.HumanoidDisplayDistanceType.None
	templateHumanoid.HealthDisplayType = Enum.HumanoidHealthDisplayType.AlwaysOff
	templateHumanoid.BreakJointsOnDeath = false

	-- Sin colisiones para no empujar al usuario
	for _, descendant in ipairs(template:GetDescendants()) do
		if descendant:IsA("BasePart") then
			descendant.CanCollide = false
		end
	end

	-- 0.5 studs enfrente del usuario, mirándolo (posición fija)
	local position = myRoot.Position + myRoot.CFrame.LookVector * WALL_COMBO_CLONE_DISTANCE
	local lookTarget = Vector3.new(myRoot.Position.X, position.Y, myRoot.Position.Z)
	local cloneCFrame = CFrame.lookAt(position, lookTarget)

	local handle = { instance = nil }
	local startTime = os.clock()
	local expired = false
	local respawns = 0
	local place

	place = function()
		if expired then return end

		local clone = template:Clone()
		local cloneRoot = clone:FindFirstChild("HumanoidRootPart")
		local cloneHumanoid = clone:FindFirstChildOfClass("Humanoid")
		if not cloneRoot or not cloneHumanoid then
			clone:Destroy()
			return
		end

		cloneRoot.CFrame = cloneCFrame
		cloneRoot.Anchored = true
		clone.Parent = workspace
		handle.instance = clone

		-- Evitar que el clon "muera" y se rompa/desaparezca
		cloneHumanoid:SetStateEnabled(Enum.HumanoidStateType.Dead, false)
		cloneHumanoid.Health = cloneHumanoid.MaxHealth

		-- Reproducir la animación (si se recrea, continúa desde donde iba)
		local animator = cloneHumanoid:FindFirstChildOfClass("Animator")
		if not animator then
			animator = Instance.new("Animator")
			animator.Parent = cloneHumanoid
		end

		local animation = Instance.new("Animation")
		animation.AnimationId = "rbxassetid://" .. WALL_COMBO_CLONE_ANIMATION_ID

		local track = animator:LoadAnimation(animation)
		animation:Destroy()
		track.Priority = Enum.AnimationPriority.Action4
		track:Play(0.15)

		local elapsed = os.clock() - startTime
		if elapsed > 0.1 then
			track.TimePosition = elapsed
		end

		-- Si algo lo elimina antes de los 10 s, se recrea
		clone.Destroying:Connect(function()
			if expired or respawns >= 10 or handle.noRespawn then return end
			respawns += 1
			task.defer(place)
		end)
	end

	place()

	-- Elimina el clon (por tiempo de vida o por interrupción). Se puede llamar varias veces sin problema.
	handle.destroy = function()
		if expired then return end
		expired = true

		if handle.instance then
			handle.instance:Destroy()
			handle.instance = nil
		end
		template:Destroy()

		if wallComboCloneHandle == handle then
			wallComboCloneHandle = nil
		end
	end

	wallComboCloneHandle = handle

	-- Tiempo de vida propio (sin Debris, que puede eliminar objetos antes si se llena)
	task.delay(WALL_COMBO_CLONE_LIFETIME, function()
		-- Si el clon está en su secuencia de impacto, esa secuencia decide cuándo eliminarlo
		if handle.keepAlive then return end
		handle.destroy()
	end)

	return handle
end

