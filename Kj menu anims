-- LocalScript: place in StarterPlayer > StarterPlayerScripts
-- This script creates a small animation/sound menu. It intentionally does not
-- include the original tools, touch detection, teleporting, or forced movement.

local Players = game:GetService("Players")
local player = Players.LocalPlayer

local currentTracks = {}
local currentSounds = {}
local movementConnection
local spawnAnimationConnection
local sequence = 0

local SPAWN_ANIMATION_ID = "17325160621"
local SPAWN_SOUND_ID = "17325174223"

local function getCharacter()
    local character = player.Character or player.CharacterAdded:Wait()
    local humanoid = character:FindFirstChildOfClass("Humanoid") or character:WaitForChild("Humanoid")
    local animator = humanoid:FindFirstChildOfClass("Animator") or Instance.new("Animator", humanoid)
    return character, humanoid, animator
end

local function stopCurrent()
    sequence += 1

    if spawnAnimationConnection then
        spawnAnimationConnection:Disconnect()
        spawnAnimationConnection = nil
    end

    for _, track in ipairs(currentTracks) do
        if track.IsPlaying then
            track:Stop(0.15)
        end
    end
    table.clear(currentTracks)

    for _, sound in ipairs(currentSounds) do
        sound:Stop()
        sound:Destroy()
    end
    table.clear(currentSounds)
end

local function playAnimation(id)
    local _, _, animator = getCharacter()
    local animation = Instance.new("Animation")
    animation.AnimationId = "rbxassetid://" .. id
    local track = animator:LoadAnimation(animation)
    animation:Destroy()
    track:Play(0.15)
    table.insert(currentTracks, track)
    return track
end

local function playSound(id, delayTime, token)
    task.delay(delayTime or 0, function()
        if token ~= sequence then
            return
        end

        local character = getCharacter()
        local sound = Instance.new("Sound")
        sound.SoundId = "rbxassetid://" .. id
        sound.Volume = 1
        sound.Parent = character:FindFirstChild("HumanoidRootPart") or character
        table.insert(currentSounds, sound)
        sound.Ended:Connect(function()
            sound:Destroy()
        end)
        sound:Play()
    end)
end

-- Plays the spawn animation and sound. Existing tracks are stopped first,
-- then the script waits briefly before starting the new animation and sound.
-- Any animation started while the spawn animation is playing is stopped.
local function playSpawnAnimation(character)
    if movementConnection then
        movementConnection:Disconnect()
        movementConnection = nil
    end

    stopCurrent()
    local token = sequence

    -- Give previously playing animations time to finish stopping.
    task.wait(0.1)

    -- Do not start the spawn animation if another action happened during the wait.
    if token ~= sequence or character ~= player.Character then
        return
    end

    local humanoid = character:WaitForChild("Humanoid")
    local animator = humanoid:FindFirstChildOfClass("Animator") or Instance.new("Animator", humanoid)

    -- Stop any tracks that may have been started during the short wait.
    for _, track in ipairs(animator:GetPlayingAnimationTracks()) do
        track:Stop(0.15)
    end

    local animation = Instance.new("Animation")
    animation.AnimationId = "rbxassetid://" .. SPAWN_ANIMATION_ID
    local track = animator:LoadAnimation(animation)
    animation:Destroy()

    -- Install the guard before playing the spawn track so animations from the
    -- default Animate script or other scripts cannot play alongside it.
    spawnAnimationConnection = animator.AnimationPlayed:Connect(function(otherTrack)
        if otherTrack ~= track and otherTrack.IsPlaying then
            otherTrack:Stop(0.15)
        end
    end)

    track:Play(0.15)
    table.insert(currentTracks, track)

    local sound = Instance.new("Sound")
    sound.SoundId = "rbxassetid://" .. SPAWN_SOUND_ID
    sound.Volume = 1
    sound.Parent = character:FindFirstChild("HumanoidRootPart") or character
    table.insert(currentSounds, sound)
    sound.Ended:Connect(function()
        sound:Destroy()
    end)
    sound:Play()

    -- Stop both the spawn animation and its sound as soon as the player moves.
    movementConnection = humanoid.Running:Connect(function(speed)
        if speed > 0 and token == sequence then
            stopCurrent()
            movementConnection:Disconnect()
            movementConnection = nil
        end
    end)

    -- Remove the guard when the spawn animation naturally ends.
    track.Stopped:Connect(function()
        if spawnAnimationConnection then
            spawnAnimationConnection:Disconnect()
            spawnAnimationConnection = nil
        end
    end)
end

local moves = {}
local moveOrder = {}

local function addMove(name, callback)
    moves[name] = callback
    table.insert(moveOrder, name)
end

addMove("Unlimited Flex Works", function(token)
    playAnimation("77727115892579")
    playSound("95410275491981", 0.2, token)
    playSound("128136381213631", 0, token)
end)

addMove("Five Seasons", function(token)
    playAnimation("18462892217")
    playSound("18460952794", 0, token)
    playSound("18460863844", 0, token)
    playSound("18460893321", 3.5, token)
    playSound("18461671633", 7.5, token)

    task.delay(12.5, function()
        if token ~= sequence then return end
        stopCurrent()
        local newToken = sequence
        playAnimation("18462894593")
        playSound("18461821277", 0, newToken)
        playSound("18462018744", 1.5, newToken)
        playSound("18462312002", 3.5, newToken)
        playSound("18462330981", 5.2, newToken)
    end)
end)

